#!/bin/bash
#PBS -N vulcan_tune
#PBS -q gpu_long
#PBS -W group_list=s2458
#PBS -l select=1:ncpus=72:ngpus=1:mem=400gb:model=gh200
#PBS -l walltime=10:00:00
#PBS -j oe
#PBS -m abe

# =============================================================================
# VULCAN Emulator — Optuna hyperparameter sweep
#
# Runs: (optional) generation → (optional) normalization → tuning
# Defaults assume the dataset is already generated + normalized on disk.
# Training and export are NOT run; each trial trains for TRIALS_EPOCHS epochs
# subject to the MedianPruner configured in src/tuning/__main__.py.
#
# Usage:
#   qsub run_tune.pbs
#   qsub -v TRIALS=200,TRIALS_EPOCHS=120 run_tune.pbs
#   qsub -v SKIP_GEN=0,SKIP_NORM=0 run_tune.pbs                          # force a data pass
#
# Environment Variables:
#   CONFIG_PATH     — config file path (default: config/vulcan_no_condensation.json)
#   TRIALS          — number of Optuna trials (default: 100)
#   TRIALS_EPOCHS   — max epochs per trial (default: 100)
#   SKIP_GEN        — skip generation (default: 1, data is already on disk)
#   SKIP_NORM       — skip normalization (default: 1, processed data is already on disk)
#   CONDA_ENV       — conda environment name (default: pyt2_8_gh)
#   REQUIRE_JAX_GPU — set to 0 to allow CPU-only JAX (default: 1)
# =============================================================================

set -euo pipefail

PROJECT_ROOT="${PROJECT_ROOT:-${PBS_O_WORKDIR:?}}"
cd -P "${PROJECT_ROOT}"
PROJECT_ROOT="$(pwd -P)"
export VULCAN_PROJECT_ROOT="${PROJECT_ROOT}"

LOG_ROOT="${LOG_ROOT:-${PROJECT_ROOT}/logs}"
mkdir -p "${LOG_ROOT}"

# --- Conda Environment ---
module purge
module use -a /swbuild/analytix/tools/modulefiles
module load miniconda3/gh2

if ! command -v conda >/dev/null 2>&1; then
  echo "ERROR: conda not found after module load."
  exit 1
fi

CONDA_BASE="$(conda info --base)"
# shellcheck disable=SC1090
source "${CONDA_BASE}/etc/profile.d/conda.sh"

CONDA_ENV="${CONDA_ENV:-pyt2_8_gh}"
set +e
conda activate "${CONDA_ENV}" 2>&1
set -e
if [[ "$(basename "${CONDA_PREFIX:-}")" != "${CONDA_ENV}" ]]; then
  echo "ERROR: failed to activate conda env: ${CONDA_ENV}"
  conda info --envs || true
  exit 2
fi

# --- Configuration ---
CONFIG_PATH="${CONFIG_PATH:-config/vulcan_no_condensation.json}"
if [[ "${CONFIG_PATH}" != /* ]]; then
  CONFIG_PATH="${PROJECT_ROOT}/${CONFIG_PATH}"
fi
TRIALS="${TRIALS:-100}"
TRIALS_EPOCHS="${TRIALS_EPOCHS:-100}"
SKIP_GEN="${SKIP_GEN:-1}"
SKIP_NORM="${SKIP_NORM:-1}"
DISABLE_TRITON_GEMM="${DISABLE_TRITON_GEMM:-1}"
REQUIRE_JAX_GPU="${REQUIRE_JAX_GPU:-1}"

# --- Environment ---
export HDF5_USE_FILE_LOCKING=FALSE
export PYTHONPATH="${PROJECT_ROOT}/src:${PROJECT_ROOT}:${PYTHONPATH:-}"
export PYTHONUNBUFFERED=1
export JAX_ENABLE_X64="${JAX_ENABLE_X64:-1}"
export XLA_PYTHON_CLIENT_PREALLOCATE="${XLA_PYTHON_CLIENT_PREALLOCATE:-true}"
export XLA_PYTHON_CLIENT_MEM_FRACTION="${XLA_PYTHON_CLIENT_MEM_FRACTION:-0.90}"
export REQUIRE_JAX_GPU
export PIP_DISABLE_PIP_VERSION_CHECK=1

XLA_FLAGS_VALUE="${XLA_FLAGS:-}"
if [ "${DISABLE_TRITON_GEMM}" = "1" ]; then
  XLA_FLAGS_VALUE="${XLA_FLAGS_VALUE} --xla_gpu_enable_triton_gemm=false"
fi
XLA_FLAGS_VALUE="${XLA_FLAGS_VALUE} --xla_gpu_autotune_level=0"
export XLA_FLAGS="${XLA_FLAGS_VALUE# }"
unset XLA_FLAGS_VALUE

# --- Preflight Checks ---
if [ ! -f "${CONFIG_PATH}" ]; then
  echo "ERROR: config not found: ${CONFIG_PATH}"
  exit 1
fi
if [ ! -d "${PROJECT_ROOT}/src" ]; then
  echo "ERROR: source directory not found: ${PROJECT_ROOT}/src"
  exit 1
fi

CONFIG_SUMMARY_RAW="$(python - "${CONFIG_PATH}" <<'PY'
from pathlib import Path
import sys

from src.utils.config import load_and_validate_config

config = load_and_validate_config(Path(sys.argv[1]).resolve())
use_condensation = bool(config["vulcan"]["physics_toggles"]["use_condensation"]) if config["chemistry_type"] == "vulcan" else False
print(config["chemistry_type"])
print(config["model_type"])
print(int(use_condensation))
PY
)" || {
  echo "ERROR: failed to validate config: ${CONFIG_PATH}"
  exit 1
}
mapfile -t CONFIG_SUMMARY <<<"${CONFIG_SUMMARY_RAW}"
if [ "${#CONFIG_SUMMARY[@]}" -lt 3 ]; then
  echo "ERROR: config validation did not return chemistry, model, and condensation flags."
  exit 1
fi
CONFIG_CHEMISTRY_TYPE="${CONFIG_SUMMARY[0]}"
CONFIG_MODEL_TYPE="${CONFIG_SUMMARY[1]}"
CONFIG_USE_CONDENSATION="${CONFIG_SUMMARY[2]}"
if [ "${CONFIG_CHEMISTRY_TYPE}" != "vulcan" ] && [ "${CONFIG_CHEMISTRY_TYPE}" != "fastchem" ]; then
  echo "ERROR: run_tune.pbs supports vulcan and fastchem, but chemistry_type=${CONFIG_CHEMISTRY_TYPE}."
  exit 1
fi
if [ "${CONFIG_MODEL_TYPE}" != "transformer" ]; then
  echo "ERROR: run_tune.pbs is for the VULCAN transformer pipeline, but model_type=${CONFIG_MODEL_TYPE}."
  exit 1
fi

echo "Config path: $(python - <<'PY' "${CONFIG_PATH}"
from pathlib import Path
import sys
print(Path(sys.argv[1]).resolve())
PY
)"
echo "chemistry_type=${CONFIG_CHEMISTRY_TYPE} model_type=${CONFIG_MODEL_TYPE} use_condensation=${CONFIG_USE_CONDENSATION}"
echo "SKIP_GEN=${SKIP_GEN} SKIP_NORM=${SKIP_NORM} TRIALS=${TRIALS} TRIALS_EPOCHS=${TRIALS_EPOCHS}"
echo "JAX_ENABLE_X64=${JAX_ENABLE_X64} REQUIRE_JAX_GPU=${REQUIRE_JAX_GPU}"

if [ -n "${PBS_JOBID:-}" ]; then
  export VULCAN_LIVE_LOG_PATH="${VULCAN_LIVE_LOG_PATH:-${LOG_ROOT}/pbs_${PBS_JOBID}.log}"
  touch "${VULCAN_LIVE_LOG_PATH}"
  echo "PBS_JOBID: ${PBS_JOBID}"
  echo "Live log: ${VULCAN_LIVE_LOG_PATH}"
fi

# GPU check.
if [ "${REQUIRE_JAX_GPU}" = "1" ]; then
  if ! command -v nvidia-smi >/dev/null 2>&1 || ! nvidia-smi >/dev/null 2>&1; then
    echo "ERROR: No visible NVIDIA GPU in this PBS job."
    exit 1
  fi
fi

# JAX backend check.
if ! python - <<'PY'
import os
import sys

ok = True
jax_backend = "unknown"
try:
    import jax
    jax_backend = str(jax.default_backend()).lower()
except Exception as exc:
    print(f"jax_error={exc!r}")
    ok = False
if os.environ.get("REQUIRE_JAX_GPU", "0") == "1" and jax_backend not in {"gpu", "cuda", "rocm", "metal"}:
    print(f"ERROR: REQUIRE_JAX_GPU=1 but jax backend is '{jax_backend}'", file=sys.stderr)
    ok = False
else:
    print(f"JAX backend: {jax_backend}")
raise SystemExit(0 if ok else 1)
PY
then
  echo "ERROR: runtime preflight failed."
  exit 1
fi

# =============================================================================
# Stage 1: Data Generation (default: skipped, data already on disk)
# =============================================================================
if [ "${SKIP_GEN}" != "1" ]; then
  echo ""
  echo "========== Stage: generation =========="
  DATA_CFG_RAW="$(python - "${CONFIG_PATH}" <<'PY'
from pathlib import Path
import json
import sys
import h5py

config_path = Path(sys.argv[1]).resolve()
project_root = Path.cwd()
with config_path.open("r", encoding="utf-8") as handle:
    cfg = json.load(handle)
run_root = Path(str(cfg["paths"]["run_root"]))
if not run_root.is_absolute():
    run_root = (project_root / run_root).resolve()
raw_root = run_root / "raw"
print(raw_root / "runs")
print(int(cfg["generation"]["num_runs"]))
consolidated_path = raw_root / "runs.h5"
print(consolidated_path)
if consolidated_path.exists():
    with h5py.File(consolidated_path, "r") as handle:
        print(len(handle.keys()))
else:
    print(0)
PY
  )" || {
    echo "ERROR: failed to inspect config: ${CONFIG_PATH}"
    exit 1
  }
  mapfile -t DATA_CFG <<<"${DATA_CFG_RAW}"
  if [ "${#DATA_CFG[@]}" -lt 4 ]; then
    echo "ERROR: config inspection did not return raw_root, num_runs, and consolidated metadata."
    exit 1
  fi
  RAW_RUN_DIR="${DATA_CFG[0]}"
  EXPECTED_RUNS="${DATA_CFG[1]}"
  CONSOLIDATED_PATH="${DATA_CFG[2]}"
  CONSOLIDATED_COUNT="${DATA_CFG[3]}"
  RUN_COUNT=0
  if [ -d "${RAW_RUN_DIR}" ]; then
    RUN_COUNT="$(find "${RAW_RUN_DIR}" -maxdepth 1 -type f -name 'run_*.h5' | wc -l | tr -d ' ')"
  fi
  if [ "${CONSOLIDATED_COUNT}" -eq "${EXPECTED_RUNS}" ]; then
    echo "Raw dataset already present in consolidated file (${CONSOLIDATED_COUNT} runs), skipping generation."
  elif [ "${RUN_COUNT}" -eq "${EXPECTED_RUNS}" ]; then
    echo "Raw dataset already present (${RUN_COUNT} per-run files), consolidation needed."
    python -u -m src.utils --config "${CONFIG_PATH}" --stage generation
  elif [ "${CONSOLIDATED_COUNT}" -eq 0 ]; then
    if [ "${RUN_COUNT}" -gt 0 ]; then
      echo "Resuming generation: ${RUN_COUNT}/${EXPECTED_RUNS} per-run files found, continuing..."
    else
      echo "Generating raw runs..."
    fi
    python -u -m src.utils --config "${CONFIG_PATH}" --stage generation
  else
    echo "ERROR: consolidated file has ${CONSOLIDATED_COUNT} runs but expected ${EXPECTED_RUNS}."
    echo "Set generation.overwrite=true and regenerate, or align generation.num_runs with the existing dataset."
    exit 1
  fi
else
  echo ""
  echo "========== Stage: generation (SKIPPED via SKIP_GEN=1) =========="
fi

# =============================================================================
# Stage 2: Normalization (default: skipped, processed data already on disk)
# =============================================================================
if [ "${SKIP_NORM}" != "1" ]; then
  echo ""
  echo "========== Stage: normalization =========="
  python -u -m src.utils --config "${CONFIG_PATH}" --stage normalization
else
  echo ""
  echo "========== Stage: normalization (SKIPPED via SKIP_NORM=1) =========="
fi

# =============================================================================
# Stage 3: Hyperparameter tuning via Optuna
# =============================================================================
echo ""
echo "========== Stage: hyperparameter tuning =========="
python -u -m src.tuning --config "${CONFIG_PATH}" --trials "${TRIALS}" --epochs "${TRIALS_EPOCHS}"

echo ""
echo "========== Pipeline complete =========="
