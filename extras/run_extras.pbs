#!/bin/bash
#PBS -N vulcan_extras
#PBS -q gpu_long
#PBS -W group_list=s2458
#PBS -l select=1:ncpus=72:ngpus=1:mem=400gb:model=gh200
#PBS -l walltime=10:00:00
#PBS -j oe
#PBS -m abe

# =============================================================================
# VULCAN Emulator Extras -- PBS Submission Script
#
# Executes the consolidated extras notebook on a GPU node.
#
# Usage:
#   qsub extras/run_extras.pbs
#   qsub -v MODEL=fastchem_no_condensation extras/run_extras.pbs
# =============================================================================

set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
PROJECT_ROOT="${PROJECT_ROOT:-$(cd -- "${SCRIPT_DIR}/.." && pwd -P)}"
cd -P "${PROJECT_ROOT}"

LOG_ROOT="${LOG_ROOT:-${PROJECT_ROOT}/logs}"
mkdir -p "${LOG_ROOT}"

# --- Conda Environment ---
module purge
module use -a /swbuild/analytix/tools/modulefiles
module load miniconda3/gh2

CONDA_BASE="$(conda info --base)"
# shellcheck disable=SC1090
source "${CONDA_BASE}/etc/profile.d/conda.sh"
conda activate "${CONDA_ENV:-pyt2_8_gh}"

# --- Configuration ---
MODEL="${MODEL:-fastchem_no_condensation}"

# --- Environment ---
export HDF5_USE_FILE_LOCKING=FALSE
export PYTHONPATH="${PROJECT_ROOT}/src:${PROJECT_ROOT}:${PYTHONPATH:-}"
export PYTHONUNBUFFERED=1
export JAX_ENABLE_X64="${JAX_ENABLE_X64:-1}"
export XLA_PYTHON_CLIENT_PREALLOCATE="${XLA_PYTHON_CLIENT_PREALLOCATE:-true}"
export XLA_PYTHON_CLIENT_MEM_FRACTION="${XLA_PYTHON_CLIENT_MEM_FRACTION:-0.90}"
export MPLBACKEND="${MPLBACKEND:-Agg}"
export XLA_FLAGS="${XLA_FLAGS:-} --xla_gpu_enable_triton_gemm=false --xla_gpu_autotune_level=0"

# Override the MODEL variable at the top of the notebook via env var.
export VULCAN_EXTRAS_MODEL="${MODEL}"

echo "MODEL=${MODEL}"

if [ -n "${PBS_JOBID:-}" ]; then
  export VULCAN_LIVE_LOG_PATH="${VULCAN_LIVE_LOG_PATH:-${LOG_ROOT}/pbs_${PBS_JOBID}.log}"
  touch "${VULCAN_LIVE_LOG_PATH}"
  echo "Live log: ${VULCAN_LIVE_LOG_PATH}"
fi

jupyter nbconvert \
  --to notebook --execute \
  --ExecutePreprocessor.timeout=3600 \
  --output extras_executed.ipynb \
  extras/extras.ipynb
