{
  "chemistry_type": "fastchem",
  "model_type": "transformer",

  "paths": {
    "run_root": "data/fastchem_transformer",
    "checkpoints_root": "models/fastchem_transformer",
    "vulcan_source_root": "../VULCAN-master"
  },

  "data_spec": {
    "state_species": [
      "H2", "He", "H", "O", "OH", "H2O", "CO", "CO2", "CH4",
      "N2", "NH3", "H2S", "SH", "S", "SO", "SO2", "S2"
    ],
    "output_species": [
      "H2", "He", "H", "O", "OH", "H2O", "CO", "CO2", "CH4",
      "N2", "NH3", "H2S", "SH", "S", "SO", "SO2", "S2"
    ]
  },

  "sampling": {
    "num_levels_range": [40, 60],
    "pressure_top_bar_range": [1e-07, 1e-05],
    "pressure_bottom_bar_range": [50.0, 500.0],
    "temperature_range_k": [100.0, 3000.0],
    "he_frac_range": [0.06, 0.12],
    "c_frac_range": [1e-5, 5e-3],
    "o_frac_range": [1e-5, 5e-3],
    "n_frac_range": [1e-6, 1e-3],
    "s_frac_range": [1e-7, 5e-4]
  },

  "temperature_profiles": {
    "source_mode": "mixed",
    "analytic_probability": 0.5,
    "data_glob": "assets/PTprofiles/*.dat",
    "filters": {
      "Teq": [1400.0, 2200.0],
      "LogMet": [0.0, 0.7],
      "TiOVO": false
    },
    "validation": {
      "min_temperature_k": 100.0,
      "max_temperature_k": 3000.0
    },
    "analytic_sampler": {
      "t_int_k_range": [100.0, 800.0],
      "t_eq_k_range": [300.0, 4000.0],
      "log10_delta_range": [-6.0, 6.0],
      "log10_gamma_range": [-2.0, 2.0],
      "alpha_range": [0.0, 0.99],
      "log10_p_trans_bar_range": [-5.0, 1.0],
      "convection_probability": 0.333,
      "adiabatic_gradient_range": [0.25, 0.35]
    }
  },

  "generation": {
    "num_runs": 100000,
    "seed": 1,
    "overwrite": false,
    "reuse_raw_if_present": false,
    "parallel_workers": 24
  },

  "normalization": {
    "split": {
      "train_fraction": 0.8,
      "val_fraction": 0.1,
      "test_fraction": 0.1,
      "seed": 123
    },
    "state_floor": 1e-30,
    "target_method": "log-standard",
    "sequence_methods": {
      "pressure_bar": "log-minmax",
      "temperature_k": "standard"
    },
    "global_methods": {
      "He_H": "standard",
      "C_H": "log-standard",
      "O_H": "log-standard",
      "N_H": "log-standard",
      "S_H": "log-standard"
    }
  },

  "training": {
    "seed": 123,
    "batch_size": 128,
    "epochs": 200,
    "learning_rate": 3e-4,
    "min_lr": 1e-6,
    "warmup_epochs": 10,
    "early_stopping_patience": 30,
    "scheduler": {
      "name": "reduce_on_plateau",
      "factor": 0.5,
      "patience": 10,
      "threshold": 1e-4
    },
    "weight_decay": 1e-5,
    "gradient_clip": 5.0,
    "loss": {
      "type": "mae",
      "lambda_z": 1.0,
      "lambda_log10_mae": 0.5
    }
  },

  "model": {
    "d_model": 256,
    "nhead": 4,
    "num_layers": 4,
    "dim_feedforward": 1024,
    "conditioning_hidden_dim": 256,
    "film_clamp": 5.0,
    "output_head_divisor": 2,
    "activation": "gelu",
    "dropout_rate": 0.05,
    "norm_type": "layernorm",
    "use_qk_norm": false,
    "ffn_type": "dense",
    "zero_init_film": false
  }
}
