{
  "_comment_units": "Pressures: bar. Temperatures: K. Abundances: number ratio rel H (n_X/n_H), solar anchors from AAG21 (Asplund, Amarsi & Grevesse 2021).",
  "chemistry_type": "exogibbs",
  "model_type": "transformer",
  "paths": {
    "run_root": "data/exogibbs_luhman16a",
    "checkpoints_root": "models/exogibbs_luhman16a",
    "vulcan_source_root": "../VULCAN-master"
  },
  "data_spec": {
    "state_species": [
      "H2", "He", "H", "O", "OH", "H2O", "CO", "CO2", "CH4",
      "N2", "NH3", "H2S", "SH", "S", "SO", "SO2", "S2"
    ],
    "output_species": [
      "H2", "He", "H", "O", "OH", "H2O", "CO", "CO2", "CH4",
      "N2", "NH3", "H2S", "SH", "S", "SO", "SO2", "S2"
    ]
  },
  "sampling": {
    "num_levels_range": [50, 80],
    "pressure_top_bar_range":    [1.0e-05, 1.0e-04],
    "pressure_bottom_bar_range": [100.0, 200.0],
    "temperature_range_k": [300.0, 3000.0],
    "_comment_abundance_ranges": "Same broad ranges as FastChem config (~0.1x to 100x solar AAG21). Covers full retrieval prior volume.",
    "he_frac_range": [5e-02, 3e-01],
    "c_frac_range": [2e-05,  3e-02],
    "o_frac_range": [4e-05,  5e-02],
    "n_frac_range": [5e-06,  7e-03],
    "s_frac_range": [1e-06,  2e-03],
    "scales": {
      "he_frac": "log",
      "c_frac": "log",
      "o_frac": "log",
      "n_frac": "log",
      "s_frac": "log"
    },
    "corner_coverage": {
      "enabled": true,
      "fraction": 0.30,
      "abundance_quantile_width": 0.15,
      "hot_tmax_k": 2500.0,
      "large_trange_k": 800.0,
      "max_profile_resample_attempts": 50
    }
  },
  "temperature_profiles": {
    "_comment": "Pure analytic: 60% power-law (ExoJAX retrieval param) + 40% Guillot with high T_int (isolated BD, no irradiation).",
    "source_mode": "analytic",
    "filters": {},
    "validation": {
      "min_temperature_k": 300.0,
      "max_temperature_k": 3000.0
    },
    "analytic_sampler": {
      "t_int_k_range":          [200.0, 1200.0],
      "t_eq_k_range":           [1.0, 500.0],
      "log10_delta_range":      [-4, 2],
      "log10_gamma_range":      [-3.0, 3.0],
      "alpha_range":            [0.0, 0.5],
      "log10_p_trans_bar_range":[-5.0, 3.0],
      "convection_probability": 0.3,
      "adiabatic_gradient_range":[0.25, 0.35],
      "power_law_probability":  0.60,
      "power_law_t0_range_k":   [800.0, 2200.0],
      "power_law_alpha_range":  [0.02, 0.20],
      "power_law_p_ref_bar":    1.0
    }
  },
  "generation": {
    "num_runs": 1000000,
    "seed": 42,
    "overwrite": false,
    "reuse_raw_if_present": true,
    "parallel_workers": 1,
    "sample_chunk_size": 5000,
    "backfill": {
      "enabled": true,
      "max_retries": 10
    }
  },
  "normalization": {
    "split": {
      "train_fraction": 0.8,
      "val_fraction": 0.1,
      "test_fraction": 0.1,
      "seed": 123
    },
    "state_floor": 1e-30,
    "target_method": "log-standard",
    "sequence_methods": {
      "pressure_bar": "log-minmax",
      "temperature_k": "standard"
    },
    "global_methods": {
      "He_H": "log-standard",
      "C_H":  "log-standard",
      "O_H":  "log-standard",
      "N_H":  "log-standard",
      "S_H":  "log-standard"
    }
  },
  "training": {
    "seed": 123,
    "batch_size": 256,
    "epochs": 200,
    "learning_rate": 0.0001,
    "min_lr": 1e-06,
    "warmup_epochs": 20,
    "early_stopping_patience": 20,
    "scheduler": {
      "name": "reduce_on_plateau",
      "factor": 0.5,
      "patience": 10,
      "threshold": 0.0001
    },
    "weight_decay": 1e-04,
    "gradient_clip": 1.0,
    "loss": {
      "type": "mae",
      "lambda_z": 1.0,
      "lambda_log10_mae": 0.25
    },
    "ema": {
      "enabled": true,
      "decay": 0.999
    }
  },
  "model": {
    "d_model": 256,
    "nhead": 4,
    "num_layers": 6,
    "dim_feedforward": 1024,
    "conditioning_hidden_dim": 256,
    "film_clamp": 100.0,
    "output_head_divisor": 1,
    "activation": "silu",
    "dropout_rate": 0.0,
    "norm_type": "layernorm",
    "use_qk_norm": false,
    "ffn_type": "dense",
    "zero_init_film": false
  }
}
