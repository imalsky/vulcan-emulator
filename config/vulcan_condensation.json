{
  "_comment_units": "Pressures: bar (or log10(bar) for log10_*_bar keys). Temperatures: K. Times: seconds. Abundances: number ratio rel H (n_X/n_H), solar anchors in src/constants.py:SOLAR_ABUNDANCES. Log10 quantities: dex.",
  "_comment_purpose": "Condensation-on emulator (separate model from no-condensation variant). H2O and S8 condensation via SNCHO_photo_network_2025; photochem off; eddy diffusion + settling on. Targets include H2O_l_s and S8_l_s columns so the surrogate predicts condensate VMRs directly.",
  "chemistry_type": "vulcan",
  "model_type": "transformer",
  "paths": {
    "run_root": "data/vulcan_condensation",
    "checkpoints_root": "models/vulcan_condensation",
    "vulcan_source_root": "../VULCAN-master"
  },
  "data_spec": {
    "_comment_state_species": "Includes H2O_l_s and S8_l_s so VULCAN tracks the condensate columns and the surrogate predicts them.",
    "state_species": [
      "H2", "He", "H", "O", "OH", "H2O", "CO", "CO2", "CH4",
      "N2", "NH3", "H2S", "SH", "S", "SO", "SO2", "S2", "S8",
      "H2O_l_s", "S8_l_s"
    ],
    "output_species": [
      "H2", "He", "H", "O", "OH", "H2O", "CO", "CO2", "CH4",
      "N2", "NH3", "H2S", "SH", "S", "SO", "SO2", "S2", "S8",
      "H2O_l_s", "S8_l_s"
    ]
  },
  "sampling": {
    "num_levels_range": [40, 60],
    "pressure_top_bar_range":    [1.0e-06, 1.0e-05],
    "pressure_bottom_bar_range": [100.0,   200.0],
    "temperature_range_k": [100.0, 3000.0],
    "_comment_abundance_ranges": "Same ranges as fastchem.json — solar-anchored Latin-hypercube with retrieval-prior margin.",
    "he_frac_range": [5e-02, 3e-01],
    "c_frac_range": [2e-05, 3e-02],
    "o_frac_range": [4e-05, 5e-02],
    "n_frac_range": [5e-06, 7e-03],
    "s_frac_range": [1e-06, 2e-03],
    "scales": {
      "he_frac": "log",
      "c_frac": "log",
      "o_frac": "log",
      "n_frac": "log",
      "s_frac": "log"
    },
    "_comment_vulcan_globals": "Per-run physical globals fed to VULCAN runtime AND the surrogate's conditioning vector.",
    "gravity_range_cm_s2":       [500.0, 5000.0],
    "planet_radius_range_cm":    [3.0e9, 1.5e10],
    "stellar_radius_range_rsun": [0.4, 1.4],
    "semi_major_axis_range_au":  [0.02, 0.2],
    "zenith_angle_range_deg":    [0.0, 60.0],
    "diurnal_factor_range":      [0.25, 1.0],
    "kzz_range_cm2_s":           [1.0e6, 1.0e10]
  },
  "temperature_profiles": {
    "source_mode": "mixed",
    "analytic_probability": 0.7,
    "data_glob": "assets/PTprofiles/*.dat",
    "filters": {
      "Teq": [600.0, 2800.0],
      "LogMet": [-0.5, 1.5]
    },
    "validation": {
      "min_temperature_k": 100.0,
      "max_temperature_k": 3000.0
    },
    "analytic_sampler": {
      "t_int_k_range":          [1.0, 1000.0],
      "t_eq_k_range":           [1.0, 3000.0],
      "log10_delta_range":      [-6, 2],
      "log10_gamma_range":      [-4.0, 4.0],
      "alpha_range":            [0.0, 0.999],
      "log10_p_trans_bar_range":[-9.0, 3.0],
      "convection_probability": 0.1,
      "adiabatic_gradient_range":[0.25, 0.35],
      "power_law_probability":  0.25,
      "power_law_t0_range_k":   [600.0, 2400.0],
      "power_law_alpha_range":  [0.0, 0.25],
      "power_law_p_ref_bar":    1.0
    }
  },
  "generation": {
    "_comment": "VULCAN runs are minutes-to-tens-of-minutes each with condensation; budget accordingly. vulcan_timeout_seconds caps stalled runs so backfill replaces them instead of hanging the pool.",
    "num_runs": 50000,
    "seed": 1,
    "overwrite": false,
    "reuse_raw_if_present": true,
    "parallel_workers": 24,
    "sample_chunk_size": 500,
    "fastchem_timeout_seconds": 30.0,
    "vulcan_timeout_seconds": 1800.0,
    "backfill": {
      "enabled": true,
      "max_retries": 20
    }
  },
  "normalization": {
    "split": {
      "train_fraction": 0.8,
      "val_fraction": 0.1,
      "test_fraction": 0.1,
      "seed": 123
    },
    "_comment_state_floor": "Higher than the FastChem 1e-30 floor: condensates are exactly zero in unsaturated levels, so a very low floor pins most condensate-target levels to a single log-space value and starves the loss signal there.",
    "state_floor": 1.0e-20,
    "target_method": "log-standard",
    "sequence_methods": {
      "pressure_bar": "log-minmax",
      "temperature_k": "standard",
      "kzz_cm2_s": "log-standard"
    },
    "global_methods": {
      "gravity_cm_s2":      "log-standard",
      "planet_radius_cm":   "log-standard",
      "He_H":               "log-standard",
      "C_H":                "log-standard",
      "O_H":                "log-standard",
      "N_H":                "log-standard",
      "S_H":                "log-standard",
      "r_star_rsun":        "log-standard",
      "semi_major_axis_au": "log-standard",
      "zenith_angle_deg":   "standard",
      "diurnal_factor":     "standard",
      "use_photochemistry":            "none",
      "use_ion_chemistry":             "none",
      "use_eddy_diffusion":            "none",
      "use_molecular_diffusion":       "none",
      "use_upwind_molecular_diffusion":"none",
      "use_boundary_conditions":       "none",
      "use_condensation":              "none",
      "use_settling":                  "none",
      "use_initial_cold_trap":         "none",
      "use_sat_surface_h2o":           "none",
      "atm_base_H2":  "none",
      "atm_base_N2":  "none",
      "atm_base_O2":  "none",
      "atm_base_CO2": "none",
      "atm_base_H2O": "none"
    }
  },
  "training": {
    "seed": 123,
    "batch_size": 256,
    "epochs": 200,
    "learning_rate": 0.0001,
    "min_lr": 1e-06,
    "warmup_epochs": 20,
    "early_stopping_patience": 20,
    "scheduler": {
      "name": "reduce_on_plateau",
      "factor": 0.5,
      "patience": 10,
      "threshold": 0.0001
    },
    "weight_decay": 1e-04,
    "gradient_clip": 1.0,
    "loss": {
      "type": "mae",
      "lambda_z": 1.0,
      "lambda_log10_mae": 0.25
    },
    "ema": {
      "enabled": true,
      "decay": 0.999
    }
  },
  "model": {
    "d_model": 256,
    "nhead": 4,
    "num_layers": 6,
    "dim_feedforward": 1024,
    "conditioning_hidden_dim": 256,
    "film_clamp": 100.0,
    "output_head_divisor": 1,
    "activation": "silu",
    "dropout_rate": 0.0,
    "norm_type": "layernorm",
    "use_qk_norm": false,
    "ffn_type": "dense",
    "zero_init_film": false
  },
  "vulcan": {
    "_comment": "All science presets share use_condensation=true so the toggle has zero variance across the dataset. fixed_globals will excise the constant from the public ExoJAX surface (per spec.md). To train a no-condensation variant, copy this config, flip use_condensation/use_settling/use_initial_cold_trap to false, drop H2O_l_s and S8_l_s from data_spec.{state,output}_species, drop the runtime.condensation block, and change run_root/checkpoints_root.",
    "physics_toggles": {
      "use_photochemistry": false,
      "use_ion_chemistry": false,
      "use_eddy_diffusion": true,
      "use_molecular_diffusion": false,
      "use_upwind_molecular_diffusion": false,
      "use_boundary_conditions": false,
      "use_condensation": true,
      "use_settling": true,
      "use_initial_cold_trap": true,
      "use_sat_surface_h2o": false
    },
    "runtime": {
      "chemistry_file": "thermo/SNCHO_photo_network_2025.txt",
      "t_cross_sp": ["H2O"],
      "regenerate_chem_funs": true,
      "use_lowT_limit_rates": true,
      "use_adaptive_rtol": true,
      "rocky": false,
      "atm_base": "H2",
      "condensation": {
        "_comment": "H2O and S8 are the only condensates with reactions in SNCHO_photo_network_2025.txt and saturation-pressure data in build_atm.sp_sat. Particle radii / densities are Jupiter-class defaults (Ackerman & Marley 2001 / Lyons 2008 reasonable choices).",
        "condense_sp":   ["H2O", "S8"],
        "non_gas_sp":    ["H2O_l_s", "S8_l_s"],
        "fix_species":   ["H2O", "S8", "H2O_l_s", "S8_l_s"],
        "use_relax":     ["H2O"],
        "humidity":       1.0,
        "start_conden_time": 1.0e6,
        "stop_conden_time":  1.0e8,
        "fix_species_time":  1.0e8,
        "fix_species_from_coldtrap_lev": true,
        "post_conden_rtol": 0.1,
        "r_p":   { "H2O_l_s": 5.0e-5, "S8_l_s": 1.0e-4 },
        "rho_p": { "H2O_l_s": 0.9,    "S8_l_s": 2.07 }
      }
    },
    "stellar_spectrum": {
      "_comment": "Required because VULCAN reads sflux_file unconditionally at startup, even with use_photochemistry=false. The pipeline auto-synthesizes a blackbody template at teff_k.",
      "template_name": "blackbody_5485K",
      "max_tokens": 4096,
      "wavelength_min_nm": 1.0,
      "wavelength_max_nm": 1000.0,
      "teff_k": 5485.0
    }
  }
}
