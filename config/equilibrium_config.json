{
  "model_type": "equilibrium",
  "paths": {
    "raw_root": "data/raw",
    "processed_root": "data/processed",
    "checkpoints_root": "models/equilibrium",
    "jax_export_root": "models/equilibrium/jax",
    "vulcan_source_root": "../VULCAN-master"
  },
  "data_spec": {
    "state_species": [
      "H2",
      "He",
      "H",
      "O",
      "OH",
      "H2O",
      "CO",
      "CO2",
      "CH4",
      "N2",
      "NH3",
      "H2S",
      "SH",
      "S",
      "SO",
      "SO2",
      "S2"
    ],
    "output_species": [
      "H2",
      "He",
      "H",
      "O",
      "OH",
      "H2O",
      "CO",
      "CO2",
      "CH4",
      "N2",
      "NH3",
      "H2S",
      "SH",
      "S",
      "SO",
      "SO2",
      "S2"
    ],
    "required_global_inputs": [
      "metallicity_log10",
      "c_to_o",
      "s_to_o"
    ]
  },
  "sampling": {
    "num_levels": 64,
    "pressure_top_bar": 1e-07,
    "pressure_bottom_bar": 100.0,
    "temperature_range_k": [
      700.0,
      1800.0
    ],
    "metallicity_log10_range": [
      0.0,
      2.0
    ],
    "c_to_o_range": [
      0.25,
      1.1
    ],
    "s_to_o_range": [
      0.005,
      0.1
    ]
  },
  "generation": {
    "mode": "vulcan",
    "num_runs": 256,
    "seed": 7,
    "overwrite": false,
    "reuse_raw_if_present": true,
    "parallel_workers": 8
  },
  "preprocessing": {
    "train_fraction": 0.67,
    "val_fraction": 0.17,
    "test_fraction": 0.16,
    "seed": 123
  },
  "normalization": {
    "state_floor": 1e-30,
    "sequence_methods": {
      "pressure_bar": "log-standard",
      "temperature_k": "standard"
    }
  },
  "training": {
    "seed": 123,
    "batch_size": 32,
    "epochs": 100,
    "learning_rate": 0.0002,
    "min_lr": 1e-05,
    "warmup_epochs": 5,
    "weight_decay": 1e-05,
    "gradient_clip": 1.0,
    "live_sampling": {
      "train_pairs_per_run_per_epoch": 1,
      "eval_pairs_per_run": 1
    },
    "model": {
      "d_model": 128,
      "nhead": 8,
      "num_layers": 4,
      "dim_feedforward": 256,
      "conditioning_hidden_dim": 128,
      "film_clamp": 1.5,
      "output_head_divisor": 2
    },
    "loss": {
      "lambda_z": 1.0,
      "lambda_phys": 0.1
    }
  }
}
