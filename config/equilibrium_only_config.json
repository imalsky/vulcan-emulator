{
  "task": {
    "kind": "equilibrium_only"
  },
  "paths": {
    "raw_root": "data/raw/equilibrium_only",
    "processed_root": "data/processed/equilibrium_only",
    "checkpoints_root": "models/equilibrium_only_silu",
    "vulcan_source_root": "../VULCAN-master"
  },
  "data_spec": {
    "state_species": [
      "H2",
      "He",
      "H",
      "O",
      "OH",
      "H2O",
      "CO",
      "CO2",
      "CH4",
      "N2",
      "NH3",
      "H2S",
      "SH",
      "S",
      "SO",
      "SO2",
      "S2"
    ],
    "output_species": [
      "H2",
      "He",
      "H",
      "O",
      "OH",
      "H2O",
      "CO",
      "CO2",
      "CH4",
      "N2",
      "NH3",
      "H2S",
      "SH",
      "S",
      "SO",
      "SO2",
      "S2"
    ],
    "required_global_inputs": [
      "metallicity_log10",
      "c_to_o",
      "s_to_o"
    ]
  },
  "sampling": {
    "num_levels": 64,
    "pressure_top_bar": 1e-07,
    "pressure_bottom_bar": 100.0,
    "temperature_range_k": [
      1.0,
      3000.0
    ],
    "metallicity_log10_range": [
      0.0,
      1.0
    ],
    "c_to_o_range": [
      0.45,
      0.85
    ],
    "s_to_o_range": [
      0.01,
      0.03
    ]
  },
  "temperature_profiles": {
    "source_mode": "mixed",
    "analytic_probability": 0.5,
    "data_glob": "assets/PTprofiles/*.dat",
    "filters": {
      "Teq": [
        1400.0,
        2200.0
      ],
      "LogMet": [
        0.0,
        0.7
      ],
      "TiOVO": false
    },
    "validation": {
      "min_temperature_k": 1.0,
      "max_temperature_k": 3000.0
    },
    "analytic_sampler": {
      "reference_gravity_m_s2": 25,
      "t_int_k_normal": {
        "mean": 500.0,
        "std": 20.0
      },
      "t_irr_k_normal": {
        "mean": 1800.0,
        "std": 500.0
      },
      "log10_kappa_ir_m2_kg_normal": {
        "mean": -2.5,
        "std": 2.5
      },
      "power_law_n_range": [
        0.5,
        2.0
      ],
      "log10_gamma_1_range": [
        -2.0,
        2.0
      ],
      "log10_gamma_2_range": [
        -2.0,
        2.0
      ],
      "alpha_range": [
        0.0,
        1.0
      ],
      "temperature_shift_k_range": [
        -500.0,
        500.0
      ],
      "convection_probability": 0.333,
      "adiabatic_gradient_range": [
        0.25,
        0.35
      ]
    }
  },
  "generation": {
    "mode": "vulcan",
    "num_runs": 50000,
    "seed": 7,
    "overwrite": true,
    "reuse_raw_if_present": false,
    "parallel_workers": 8
  },
  "normalization": {
    "split": {
      "train_fraction": 0.8,
      "val_fraction": 0.1,
      "test_fraction": 0.1,
      "seed": 123
    },
    "state_floor": 1e-30,
    "sequence_methods": {
      "pressure_bar": "log-standard",
      "temperature_k": "standard"
    }
  },
  "training": {
    "seed": 123,
    "batch_size": 4096,
    "epochs": 300,
    "learning_rate": 1e-4,
    "min_lr": 1e-6,
    "warmup_epochs": 10,
    "scheduler": {
      "name": "reduce_on_plateau",
      "factor": 0.5,
      "patience": 10,
      "threshold": 1e-4
    },
    "weight_decay": 1e-5,
    "gradient_clip": 1.0,
    "live_sampling": {
      "train_pairs_per_run_per_epoch": 1,
      "eval_pairs_per_run": 1
    },
    "loss": {
      "lambda_z": 1.0,
      "lambda_phys": 0.1
    }
  },
  "equilibrium_only": {
    "model": {
      "activation": "silu",
      "d_hidden": 1024,
      "num_hidden_layers": 6,
      "conditioning_hidden_dim": 64,
      "film_clamp": 5
    }
  }
}
