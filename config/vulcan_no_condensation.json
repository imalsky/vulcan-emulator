{
  "_notes": {
    "chemistry_type_options": {
      "fastchem": "Pure chemical equilibrium via FastChem. Fast (seconds per run). No vertical mixing, no Kzz, no quench chemistry. Inputs are just T-P profile + elemental abundances. Use this when equilibrium is sufficient or you need fast data generation.",
      "vulcan": "Full VULCAN kinetic-chemistry integration. Slow (minutes-hours per run). Supports vertical mixing (Kzz/eddy diffusion), photochemistry, condensation, and other physics. The converged state captures disequilibrium effects like CO/CH4 and N2/NH3 quenching. Use this when you need transport-driven departures from equilibrium."
    },
    "switching_to_vulcan_with_kzz": [
      "1. Change chemistry_type to 'vulcan'",
      "2. Add to sampling: gravity_range_cm_s2, planet_radius_range_cm, stellar_radius_range_rsun, semi_major_axis_range_au, zenith_angle_range_deg, diurnal_factor_range, kzz_cm2_s",
      "3. Add to normalization.sequence_methods: kzz_cm2_s",
      "4. Add to normalization.global_methods: gravity_cm_s2, planet_radius_cm, r_star_rsun, semi_major_axis_au, zenith_angle_deg, diurnal_factor, plus all physics toggles and atm_base flags (see vulcan_condensation.json for the full list)",
      "5. Add a 'vulcan' section with physics_toggles (set use_eddy_diffusion: true for Kzz), science_presets, runtime, and stellar_spectrum (see vulcan_condensation.json for a complete example)"
    ]
  },

  "chemistry_type": "fastchem",
  "model_type": "transformer",
  "paths": {
    "run_root": "data/fastchem_no_condensation",
    "checkpoints_root": "models/fastchem_no_condensation",
    "vulcan_source_root": "../VULCAN-master"
  },
  "data_spec": {
    "state_species": [
      "H2", "He", "H", "O", "OH", "H2O", "CO", "CO2", "CH4",
      "N2", "NH3", "H2S", "SH", "S", "SO", "SO2", "S2"
    ],
    "output_species": [
      "H2", "He", "H", "O", "OH", "H2O", "CO", "CO2", "CH4",
      "N2", "NH3", "H2S", "SH", "S", "SO", "SO2", "S2"
    ]
  },
  "sampling": {
    "num_levels": 64,
    "pressure_top_bar": 1e-05,
    "pressure_bottom_bar": 100.0,
    "temperature_range_k": [1.0, 3000.0],
    "he_frac_range": [0.06, 0.12],
    "c_frac_range": [1e-5, 5e-3],
    "o_frac_range": [1e-5, 5e-3],
    "n_frac_range": [1e-6, 1e-3],
    "s_frac_range": [1e-7, 5e-4]
  },
  "temperature_profiles": {
    "source_mode": "mixed",
    "analytic_probability": 0.5,
    "data_glob": "assets/PTprofiles/*.dat",
    "filters": {
      "Teq": [1400.0, 2200.0],
      "LogMet": [0.0, 0.7],
      "TiOVO": false
    },
    "validation": {
      "min_temperature_k": 1.0,
      "max_temperature_k": 3000.0
    },
    "analytic_sampler": {
      "reference_gravity_m_s2": 25,
      "t_int_k_range": [100.0, 800.0],
      "t_eq_k_range": [300.0, 4000.0],
      "log10_delta_range": [-6.0, 6.0],
      "log10_gamma_range": [-2.0, 2.0],
      "alpha_range": [0.0, 0.99],
      "log10_p_trans_bar_range": [-5.0, 1.0],
      "convection_probability": 0.333,
      "adiabatic_gradient_range": [0.25, 0.35]
    }
  },
  "generation": {
    "mode": "vulcan",
    "num_runs": 500,
    "seed": 1,
    "overwrite": false,
    "reuse_raw_if_present": true,
    "parallel_workers": 0,
    "backfill": {
      "enabled": true,
      "max_retries": 3
    }
  },
  "normalization": {
    "split": {
      "train_fraction": 0.8,
      "val_fraction": 0.1,
      "test_fraction": 0.1,
      "seed": 123
    },
    "state_floor": 1e-30,
    "target_method": "log-standard",
    "sequence_methods": {
      "pressure_bar": "log-minmax",
      "temperature_k": "standard"
    },
    "global_methods": {
      "He_H": "standard",
      "C_H": "log-standard",
      "O_H": "log-standard",
      "N_H": "log-standard",
      "S_H": "log-standard"
    }
  },
  "training": {
    "seed": 123,
    "batch_size": 256,
    "epochs": 300,
    "learning_rate": 0.0003,
    "min_lr": 1e-06,
    "warmup_epochs": 10,
    "early_stopping_patience": 30,
    "scheduler": {
      "name": "reduce_on_plateau",
      "factor": 0.5,
      "patience": 10,
      "threshold": 0.0001
    },
    "weight_decay": 1e-05,
    "gradient_clip": 1.0,
    "loss": {
      "lambda_z": 1.0,
      "lambda_phys": 0.25
    }
  },
  "model": {
    "d_model": 256,
    "nhead": 8,
    "num_layers": 6,
    "dim_feedforward": 512,
    "conditioning_hidden_dim": 256,
    "film_clamp": 100.0,
    "output_head_divisor": 2,
    "activation": "gelu",
    "dropout_rate": 0.00
  }
}
