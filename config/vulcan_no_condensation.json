{
  "chemistry_type": "vulcan",
  "model_type": "transformer",
  "paths": {
    "run_root": "data/vulcan_no_condensation",
    "checkpoints_root": "models/vulcan_no_condensation",
    "vulcan_source_root": "../VULCAN-master"
  },
  "data_spec": {
    "state_species": [
      "H2", "He", "H", "O", "OH", "H2O", "CO", "CO2", "CH4",
      "N2", "NH3", "H2S", "SH", "S", "SO", "SO2", "S2"
    ],
    "output_species": [
      "H2", "He", "H", "O", "OH", "H2O", "CO", "CO2", "CH4",
      "N2", "NH3", "H2S", "SH", "S", "SO", "SO2", "S2"
    ]
  },
  "sampling": {
    "num_levels": 64,
    "pressure_top_bar": 1e-07,
    "pressure_bottom_bar": 100.0,
    "temperature_range_k": [1.0, 3000.0],
    "he_frac_range": [0.06, 0.12],
    "c_frac_range": [1e-5, 5e-3],
    "o_frac_range": [1e-5, 5e-3],
    "n_frac_range": [1e-6, 1e-3],
    "s_frac_range": [1e-7, 5e-4],
    "gravity_range_cm_s2": [500.0, 5000.0],
    "planet_radius_range_cm": [7000000000.0, 12000000000.0],
    "stellar_radius_range_rsun": [0.7, 1.3],
    "semi_major_axis_range_au": [0.03, 0.08],
    "zenith_angle_range_deg": [30.0, 75.0],
    "diurnal_factor_range": [0.25, 0.75],
    "kzz_cm2_s": 1000000000.0
  },
  "temperature_profiles": {
    "source_mode": "mixed",
    "analytic_probability": 0.0,
    "data_glob": "assets/PTprofiles/*.dat",
    "filters": {
      "Teq": [1400.0, 2200.0],
      "LogMet": [0.0, 0.7],
      "TiOVO": false
    },
    "validation": {
      "min_temperature_k": 1.0,
      "max_temperature_k": 3000.0
    },
    "analytic_sampler": {
      "reference_gravity_m_s2": 25,
      "t_int_k_range": [100.0, 800.0],
      "t_eq_k_range": [300.0, 4000.0],
      "log10_delta_range": [-6.0, 6.0],
      "log10_gamma_range": [-2.0, 2.0],
      "alpha_range": [0.0, 0.99],
      "log10_p_trans_bar_range": [-5.0, 1.0],
      "convection_probability": 0.333,
      "adiabatic_gradient_range": [0.25, 0.35]
    }
  },
  "generation": {
    "mode": "vulcan",
    "num_runs": 1000,
    "seed": 1,
    "overwrite": false,
    "reuse_raw_if_present": true,
    "parallel_workers": 0,
    "backfill": {
      "enabled": true,
      "max_retries": 3
    }
  },
  "normalization": {
    "split": {
      "train_fraction": 0.8,
      "val_fraction": 0.1,
      "test_fraction": 0.1,
      "seed": 123
    },
    "state_floor": 1e-30,
    "target_method": "log-standard",
    "sequence_methods": {
      "pressure_bar": "log-minmax",
      "temperature_k": "standard",
      "kzz_cm2_s": "log-standard"
    },
    "global_methods": {
      "gravity_cm_s2": "log-standard",
      "planet_radius_cm": "log-standard",
      "He_H": "standard",
      "C_H": "log-standard",
      "O_H": "log-standard",
      "N_H": "log-standard",
      "S_H": "log-standard",
      "r_star_rsun": "log-standard",
      "semi_major_axis_au": "log-standard",
      "zenith_angle_deg": "standard",
      "diurnal_factor": "standard",
      "use_photochemistry": "none",
      "use_ion_chemistry": "none",
      "use_eddy_diffusion": "none",
      "use_molecular_diffusion": "none",
      "use_upwind_molecular_diffusion": "none",
      "use_boundary_conditions": "none",
      "use_condensation": "none",
      "use_settling": "none",
      "use_initial_cold_trap": "none",
      "use_sat_surface_h2o": "none",
      "atm_base_H2": "none",
      "atm_base_N2": "none",
      "atm_base_O2": "none",
      "atm_base_CO2": "none",
      "atm_base_H2O": "none"
    }
  },
  "training": {
    "seed": 123,
    "batch_size": 256,
    "epochs": 300,
    "learning_rate": 0.0003,
    "min_lr": 1e-06,
    "warmup_epochs": 10,
    "early_stopping_patience": 30,
    "scheduler": {
      "name": "reduce_on_plateau",
      "factor": 0.5,
      "patience": 10,
      "threshold": 0.0001
    },
    "weight_decay": 1e-05,
    "gradient_clip": 1.0,
    "loss": {
      "lambda_z": 1.0,
      "lambda_phys": 0.25
    }
  },
  "model": {
    "d_model": 256,
    "nhead": 8,
    "num_layers": 6,
    "dim_feedforward": 512,
    "conditioning_hidden_dim": 256,
    "film_clamp": 100.0,
    "output_head_divisor": 2,
    "activation": "gelu",
    "dropout_rate": 0.00
  },
  "vulcan": {
    "physics_toggles": {
      "use_photochemistry": false,
      "use_condensation": false,
      "use_ion_chemistry": false,
      "use_eddy_diffusion": true,
      "use_molecular_diffusion": false,
      "use_upwind_molecular_diffusion": false,
      "use_boundary_conditions": false,
      "use_settling": false,
      "use_initial_cold_trap": false,
      "use_sat_surface_h2o": false
    },
    "science_presets": [
      {
        "name": "basic_h2",
        "atm_base": "H2",
        "physics_toggles": {
          "use_photochemistry": false,
          "use_condensation": false,
          "use_eddy_diffusion": true,
          "use_initial_cold_trap": false
        }
      }
    ],
    "runtime": {
      "chemistry_file": "thermo/SNCHO_photo_network_2025.txt",
      "regenerate_chem_funs": true,
      "rocky": false,
      "atm_base": "H2",
      "cfg_assignments": {},
      "t_cross_sp": ["H2", "He"]
    },
    "stellar_spectrum": {
      "template_name": "blackbody",
      "template_file": null,
      "library_glob": null,
      "wavelength_min_nm": 2.0,
      "wavelength_max_nm": 700.0,
      "dbin1_nm": 0.1,
      "dbin2_nm": 2.0,
      "dbin_12trans_nm": 240.0,
      "max_tokens": 2610,
      "teff_k": 5485.0,
      "radius_rsun": 0.939,
      "semi_major_axis_au": 0.04858
    }
  }
}
