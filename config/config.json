{
  "paths": {
    "project_root": ".",
    "vulcan_source_path": "../VULCAN-master",
    "data_root": "data",
    "raw_root": "data/raw",
    "processed_root": "data/processed",
    "models_root": "models",
    "logs_root": "logs"
  },
  "generation": {
    "num_runs": 1000,
    "num_workers": 64,
    "split_ratios": {
      "train": 0.8,
      "val": 0.1,
      "test": 0.1
    },
    "random_seed": 42,
    "keep_vulcan_outputs_debug": false,
    "run_timeout_seconds": 180,
    "manifest_filename": "dataset_manifest.json",
    "split_filename": "splits.json",
    "worker_root": "data/raw/_workers",
    "save_evo_frq": 10,
    "max_trajectory_snapshots": 200
  },
  "trajectory_sampling": {
    "mode": "log_uniform_all_pairs",
    "dt_min_s": 1e8,
    "dt_max_s": 1e10,
    "min_future_saved_steps": 1
  },
  "vulcan_runtime": {
    "runtime": 1e+13,
    "dt_min": 1e-14,
    "dt_max": 1000000000000.0,
    "count_max": 30000,
    "trun_min": 1e+11,
    "count_min": 120,
    "ini_mix": "EQ",
    "atm_base": "H2"
  },
  "tp_sampler": {
    "pressure_grid": {
      "nz": 50,
      "p_top_bar": 1e-08,
      "p_bottom_bar": 1e3
    },
    "temperature_limits_k": {
      "min": 500.0,
      "max": 2500.0
    },
    "max_sampling_attempts": 32,
    "adiabatic_gradient": 0.286,
    "convective_adjustment_probability": 0.3333333333,
    "log10_kappa_ir": {
      "distribution": "uniform",
      "min": -2.5,
      "max": 2.5
    },
    "kappa_pressure_power_exponent": {
      "distribution": "uniform",
      "min": -0.5,
      "max": 1.0
    },
    "log10_gamma1": {
      "distribution": "uniform",
      "min": -2.0,
      "max": 2.0
    },
    "log10_gamma2": {
      "distribution": "uniform",
      "min": -2.0,
      "max": 2.0
    },
    "alpha_partition": {
      "distribution": "uniform",
      "min": 0.0,
      "max": 1.0
    },
    "t_int": {
      "distribution": "normal",
      "mean": 300.0,
      "std": 700.0,
      "min": 50.0,
      "max": 3000.0
    },
    "t_irr": {
      "distribution": "normal",
      "mean": 1800.0,
      "std": 500.0,
      "min": 200.0,
      "max": 4000.0
    },
    "temperature_shift": {
      "distribution": "uniform",
      "min": -500.0,
      "max": 500.0
    }
  },
  "gravity_sampler": {
    "distribution": "uniform",
    "min_cm_s2": 500.0,
    "max_cm_s2": 20000.0
  },
  "kzz_sampler": {
    "mode": "power_law_profile",
    "log10_kzz_at_1bar_min": 7.0,
    "log10_kzz_at_1bar_max": 11.0,
    "beta_min": 0.3,
    "beta_max": 0.7,
    "kzz_floor_cm2_s": 10000000.0,
    "kzz_cap_cm2_s": 1000000000000.0,
    "pressure_unit_for_profile": "bar"
  },
  "abundance_sampler": {
    "metallicity_mode": "log10_scale",
    "log10_metallicity_min": -0.5,
    "log10_metallicity_max": 2.0,
    "c_to_o_min": 0.3,
    "c_to_o_max": 1.2,
    "solar_abundances": {
      "O_H": 0.000537,
      "N_H": 7.08e-05,
      "He_H": 0.0838,
      "S_H": 1.41e-05
    }
  },
  "physics_toggles": {
    "use_photochemistry": false,
    "use_ion_chemistry": false,
    "use_eddy_diffusion": true,
    "use_molecular_diffusion": true,
    "use_upwind_molecular_diffusion": false,
    "use_boundary_conditions": false,
    "use_condensation": false,
    "use_settling": false,
    "use_initial_cold_trap": true,
    "use_sat_surface_h2o": true,
    "use_lowT_limit_rates": false,
    "use_adaptive_rtol": true
  },
  "data_spec": {
    "state_species": [
      "H2",
      "He",
      "H2O",
      "CO",
      "CO2",
      "CH4",
      "N2",
      "NH3"
    ],
    "output_species": [
      "H2",
      "He",
      "H2O",
      "CO",
      "CO2",
      "CH4",
      "N2",
      "NH3"
    ],
    "required_input_profiles": [
      "pressure_bar",
      "temperature_k",
      "kzz_cm2_s"
    ],
    "required_global_inputs": [
      "gravity_cm_s2",
      "metallicity_log10",
      "c_to_o",
      "log10_dt_s",
      "use_eddy_diffusion",
      "use_molecular_diffusion",
      "use_upwind_molecular_diffusion",
      "use_boundary_conditions",
      "use_condensation",
      "use_settling",
      "use_initial_cold_trap",
      "use_sat_surface_h2o",
      "use_lowT_limit_rates",
      "use_adaptive_rtol",
      "atm_base_H2",
      "atm_base_N2",
      "atm_base_O2",
      "atm_base_CO2",
      "atm_base_H2O"
    ],
    "required_state_inputs": [
      "anchor_ymix"
    ],
    "time_input_transform": "log10_dt_seconds",
    "strict_non_finite": true
  },
  "normalization": {
    "epsilon": 1e-30,
    "sequence_methods": {
      "pressure_bar": "log-min-max",
      "temperature_k": "standard",
      "kzz_cm2_s": "log-standard",
      "anchor_ymix": "log-standard"
    },
    "global_methods": {
      "gravity_cm_s2": "log-standard",
      "metallicity_log10": "standard",
      "c_to_o": "standard",
      "log10_dt_s": "standard",
      "use_eddy_diffusion": "none",
      "use_molecular_diffusion": "none",
      "use_upwind_molecular_diffusion": "none",
      "use_boundary_conditions": "none",
      "use_condensation": "none",
      "use_settling": "none",
      "use_initial_cold_trap": "none",
      "use_sat_surface_h2o": "none",
      "use_lowT_limit_rates": "none",
      "use_adaptive_rtol": "none",
      "atm_base_H2": "none",
      "atm_base_N2": "none",
      "atm_base_O2": "none",
      "atm_base_CO2": "none",
      "atm_base_H2O": "none"
    },
    "target_method": "log-standard"
  },
  "precision": {
    "input_dtype": "float32",
    "stats_accumulation_dtype": "float32",
    "model_dtype": "float32",
    "forward_dtype": "float32",
    "loss_dtype": "float32",
    "optimizer_state_dtype": "float32",
    "amp_autocast_dtype": "none"
  },
  "training": {
    "device": "cuda",
    "batch_size": 256,
    "epochs": 300,
    "learning_rate": 1e-4,
    "min_lr": 1e-06,
    "warmup_epochs": 10,
    "weight_decay": 1e-05,
    "gradient_clip": 1.0,
    "use_amp": false,
    "seed": 42,
    "live_sampling": {
      "train_pairs_per_run_per_epoch": 500,
      "eval_pairs_per_run": 500
    },
    "model": {
      "d_model": 256,
      "nhead": 4,
      "num_layers": 6,
      "dim_feedforward": 1024,
      "dropout": 0.05,
      "film_clamp": 10.0,
      "output_head_divisor": 2,
      "max_sequence_length": 64,
      "conditioning_hidden_dim": 256
    },
    "loss": {
      "lambda_z": 0.5,
      "lambda_phys": 1.0
    },
    "output_folder": "trained_model"
  }
}
