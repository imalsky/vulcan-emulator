{
  "paths": {
    "project_root": ".",
    "vulcan_source_path": "../VULCAN-master",
    "data_root": "data",
    "models_root": "models",
    "logs_root": "logs"
  },
  "generation": {
    "num_runs": 10,
    "num_workers": 1,
    "split_ratios": {
      "train": 0.8,
      "val": 0.1,
      "test": 0.1
    },
    "random_seed": 42,
    "keep_vulcan_outputs_debug": false,
    "failure_policy": "fail_on_first_error",
    "run_timeout_seconds": 900,
    "manifest_filename": "dataset_manifest.json",
    "split_filename": "splits.json",
    "shard_size": 256,
    "worker_root": "data/raw/_workers",
    "runs_root": "data/raw/runs",
    "save_evo_frq": 1
  },
  "trajectory_sampling": {
    "pairs_per_run": 256,
    "requested_dt_min_s": 1e-06,
    "requested_dt_max_s": 1e+16,
    "requested_dt_spacing": "log_uniform",
    "allow_anchor_at_t0": true,
    "min_future_saved_steps": 1,
    "rollout_eval_points": 8
  },
  "vulcan_runtime": {
    "runtime": 1e+16,
    "dt_min": 1e-14,
    "dt_max": 1e+12,
    "count_max": 200000,
    "trun_min": 0.0,
    "count_min": 0,
    "y_time_freq": 1
  },
  "tp_sampler": {
    "pressure_grid": {
      "nz": 12,
      "p_top_bar": 1e-08,
      "p_bottom_bar": 1000.0
    },
    "temperature_limits_k": {
      "min": 100.0,
      "max": 4000.0
    },
    "max_sampling_attempts": 32,
    "adiabatic_gradient": 0.286,
    "convective_adjustment_probability": 0.3333333333,
    "log10_kappa_ir": {
      "distribution": "uniform",
      "min": -2.5,
      "max": 2.5
    },
    "kappa_pressure_power_exponent": {
      "distribution": "uniform",
      "min": -0.5,
      "max": 1.0
    },
    "log10_gamma1": {
      "distribution": "uniform",
      "min": -2.0,
      "max": 2.0
    },
    "log10_gamma2": {
      "distribution": "uniform",
      "min": -2.0,
      "max": 2.0
    },
    "alpha_partition": {
      "distribution": "uniform",
      "min": 0.0,
      "max": 1.0
    },
    "t_int": {
      "distribution": "normal",
      "mean": 300.0,
      "std": 700.0,
      "min": 50.0,
      "max": 3000.0
    },
    "t_irr": {
      "distribution": "normal",
      "mean": 1800.0,
      "std": 500.0,
      "min": 200.0,
      "max": 4000.0
    },
    "temperature_shift": {
      "distribution": "uniform",
      "min": -600.0,
      "max": 600.0
    }
  },
  "gravity_sampler": {
    "distribution": "uniform",
    "min_cm_s2": 500.0,
    "max_cm_s2": 5000.0
  },
  "kzz_sampler": {
    "mode": "power_law_profile",
    "log10_kzz_at_1bar_min": 8.0,
    "log10_kzz_at_1bar_max": 10.0,
    "beta_min": 0.4,
    "beta_max": 0.6,
    "kzz_floor_cm2_s": 10000000.0,
    "kzz_cap_cm2_s": 1000000000000.0,
    "pressure_unit_for_profile": "bar"
  },
  "abundance_sampler": {
    "metallicity_mode": "log10_scale",
    "log10_metallicity_min": -0.5,
    "log10_metallicity_max": 1.0,
    "c_to_o_min": 0.3,
    "c_to_o_max": 1.2,
    "solar_abundances": {
      "O_H": 0.000537,
      "N_H": 7.08e-05,
      "He_H": 0.0838,
      "S_H": 1.41e-05
    }
  },
  "physics_toggles": {
    "use_photochemistry": false,
    "use_ion_chemistry": false,
    "use_transport": true,
    "use_boundary_conditions": false,
    "use_condensation_optional": true
  },
  "data_spec": {
    "state_species": [
      "H2", "He", "H", "H2O", "CH4", "CO", "CO2", "NH3", "HCN", "C2H2",
      "N2", "OH", "O", "NO", "NO2", "O2", "H2CO", "CH3OH", "C2H4", "C2H6"
    ],
    "output_species": [
      "H2", "He", "H", "H2O", "CH4", "CO", "CO2", "NH3", "HCN", "C2H2",
      "N2", "OH", "O", "NO", "NO2", "O2", "H2CO", "CH3OH", "C2H4", "C2H6"
    ],
    "required_input_profiles": ["pressure_bar", "temperature_k", "kzz_cm2_s"],
    "required_global_inputs": ["gravity_cm_s2", "metallicity_log10", "c_to_o", "log10_dt_s"],
    "required_state_inputs": ["anchor_ymix"],
    "time_input_transform": "log10_dt_seconds",
    "strict_non_finite": true
  },
  "normalization": {
    "epsilon": 1e-30,
    "sequence_methods": {
      "pressure_bar": "log-min-max",
      "temperature_k": "standard",
      "kzz_cm2_s": "log-standard",
      "anchor_ymix": "log-standard"
    },
    "global_methods": {
      "gravity_cm_s2": "log-standard",
      "metallicity_log10": "standard",
      "c_to_o": "standard",
      "log10_dt_s": "standard"
    },
    "target_method": "log-standard"
  },
  "precision": {
    "input_dtype": "float32",
    "stats_accumulation_dtype": "float32",
    "model_dtype": "float32",
    "forward_dtype": "float32",
    "loss_dtype": "float32",
    "optimizer_state_dtype": "float32",
    "amp_autocast_dtype": "none"
  },
  "training": {
    "device": "cpu",
    "gpu_preload": false,
    "batch_size": 32,
    "epochs": 100,
    "learning_rate": 0.0005,
    "min_lr": 1e-05,
    "warmup_epochs": 5,
    "weight_decay": 1e-05,
    "gradient_clip": 1.0,
    "use_amp": false,
    "num_workers": 0,
    "seed": 42,
    "data_loading": {
      "mode": "ram",
      "max_cached_shards": 2,
      "large_shard_mmap_bytes": 134217728,
      "ram_safety_fraction": 0.8,
      "copy_mmap_slices": false,
      "use_device_prefetch": false
    },
    "model": {
      "d_model": 128,
      "nhead": 8,
      "num_layers": 4,
      "dim_feedforward": 384,
      "dropout": 0.0,
      "film_clamp": 10.0,
      "output_head_divisor": 2,
      "max_sequence_length": 64,
      "conditioning_hidden_dim": 128
    },
    "output_folder": "trained_model"
  }
}
