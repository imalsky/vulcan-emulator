{
  "paths": {
    "raw_root": "data/raw",
    "processed_root": "data/processed",
    "checkpoints_root": "models/default",
    "jax_export_root": "models/default/jax",
    "vulcan_source_root": "../VULCAN-master"
  },
  "data_spec": {
    "state_species": [
      "H2",
      "He",
      "H",
      "O",
      "OH",
      "H2O",
      "CO",
      "CO2",
      "CH4",
      "N2",
      "NH3",
      "H2S",
      "SH",
      "S",
      "SO",
      "SO2",
      "S2"
    ],
    "output_species": [
      "H2",
      "He",
      "H",
      "O",
      "OH",
      "H2O",
      "CO",
      "CO2",
      "CH4",
      "N2",
      "NH3",
      "H2S",
      "SH",
      "S",
      "SO",
      "SO2",
      "S2"
    ],
    "required_global_inputs": [
      "gravity_cm_s2",
      "metallicity_log10",
      "c_to_o",
      "log10_dt_s",
      "use_photochemistry",
      "use_ion_chemistry",
      "use_eddy_diffusion",
      "use_molecular_diffusion",
      "use_upwind_molecular_diffusion",
      "use_boundary_conditions",
      "use_condensation",
      "use_settling",
      "use_initial_cold_trap",
      "use_sat_surface_h2o",
      "use_lowT_limit_rates",
      "use_adaptive_rtol",
      "atm_base_H2",
      "atm_base_N2",
      "atm_base_O2",
      "atm_base_CO2",
      "atm_base_H2O"
    ]
  },
  "physics_toggles": {
    "use_photochemistry": true,
    "use_ion_chemistry": false,
    "use_eddy_diffusion": true,
    "use_molecular_diffusion": false,
    "use_upwind_molecular_diffusion": false,
    "use_boundary_conditions": false,
    "use_condensation": false,
    "use_settling": false,
    "use_initial_cold_trap": false,
    "use_sat_surface_h2o": false,
    "use_lowT_limit_rates": false,
    "use_adaptive_rtol": false
  },
  "vulcan_runtime": {
    "python_executable": "python",
    "cfg_file": "vulcan_cfg.py",
    "chemistry_file": "thermo/SNCHO_photo_network_2025.txt",
    "worker_root": "data/vulcan_workers",
    "regenerate_chem_funs": true,
    "atm_base": "H2",
    "t_cross_sp": [
      "H2O",
      "H2S",
      "SH",
      "SO2",
      "S2"
    ],
    "cfg_assignments": {}
  },
  "sampling": {
    "num_levels": 64,
    "pressure_top_bar": 1e-07,
    "pressure_bottom_bar": 100.0,
    "temperature_range_k": [
      700.0,
      1800.0
    ],
    "gravity_range_cm_s2": [
      300.0,
      900.0
    ],
    "metallicity_log10_range": [
      0.0,
      2.0
    ],
    "c_to_o_range": [
      0.25,
      1.1
    ],
    "kzz_cm2_s": 100000000.0,
    "num_time_steps": 24,
    "time_step_log10_min_s": 1.0,
    "time_step_log10_max_s": 5.0
  },
  "stellar_spectrum": {
    "enabled": true,
    "template_name": "wasp39b_frances_surface_flux",
    "template_file": "../VULCAN-master/atm/stellar_flux/sflux-wasp39-frances.txt",
    "num_bins": 256,
    "wavelength_min_nm": 0.05,
    "wavelength_max_nm": 700.0,
    "encoder_mode": "autoencoder",
    "latent_dim": 16,
    "hidden_dim": 64,
    "teff_k": 5485.0,
    "radius_rsun": 0.939,
    "semi_major_axis_au": 0.04858,
    "zenith_angle_deg": 48.0,
    "diurnal_factor": 1.0
  },
  "generation": {
    "mode": "vulcan",
    "num_runs": 128,
    "seed": 7,
    "overwrite": false,
    "reuse_raw_if_present": true,
    "parallel_workers": 8
  },
  "trajectory_sampling": {
    "dt_min_s": 100.0,
    "dt_max_s": 100000.0,
    "min_future_saved_steps": 1,
    "num_logdt_bins": 8
  },
  "inference": {
    "equilibrium_anchor": {
      "source": "trajectory",
      "split": "train",
      "run_id": null,
      "step_index": 0
    }
  },
  "preprocessing": {
    "train_fraction": 0.67,
    "val_fraction": 0.17,
    "test_fraction": 0.16,
    "seed": 123
  },
  "normalization": {
    "state_floor": 1e-30,
    "spectrum_floor": 1e-30,
    "sequence_methods": {
      "pressure_bar": "log-standard",
      "temperature_k": "standard",
      "kzz_cm2_s": "log-standard"
    }
  },
  "training": {
    "seed": 123,
    "batch_size": 32,
    "epochs": 20,
    "learning_rate": 0.0002,
    "min_lr": 1e-05,
    "warmup_epochs": 0,
    "weight_decay": 1e-05,
    "gradient_clip": 1.0,
    "live_sampling": {
      "train_pairs_per_run_per_epoch": 128,
      "eval_pairs_per_run": 32
    },
    "model": {
      "d_model": 128,
      "nhead": 8,
      "num_layers": 4,
      "dim_feedforward": 256,
      "conditioning_hidden_dim": 256,
      "film_clamp": 1.5,
      "output_head_divisor": 2
    },
    "loss": {
      "lambda_z": 1.0,
      "lambda_phys": 0.1,
      "lambda_spectrum": 0.01
    }
  }
}
