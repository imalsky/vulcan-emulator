      "gravity_cm_s2",
      "metallicity_log10",
      "c_to_o",
      "log10_dt_s"
    ],
    "required_state_inputs": [
      "anchor_ymix"
    ],
    "time_input_transform": "log10_dt_seconds",
    "strict_non_finite": true
  },
  "normalization": {
    "epsilon": 1e-30,
    "sequence_methods": {
      "pressure_bar": "log-min-max",
      "temperature_k": "standard",
      "kzz_cm2_s": "log-standard",
      "anchor_ymix": "log-standard"
    },
    "global_methods": {
      "gravity_cm_s2": "log-standard",
      "metallicity_log10": "standard",
      "c_to_o": "standard",
      "log10_dt_s": "standard"
    },
    "target_method": "log-standard"
  },
  "precision": {
    "input_dtype": "float32",
    "stats_accumulation_dtype": "float32",
    "model_dtype": "float32",
    "forward_dtype": "float32",
    "loss_dtype": "float32",
    "optimizer_state_dtype": "float32",
    "amp_autocast_dtype": "none"
  },
  "training": {
    "device": "cuda",
    "gpu_preload": true,
    "batch_size": 32,
    "epochs": 100,
    "learning_rate": 0.0005,
    "min_lr": 1e-05,
    "warmup_epochs": 5,
    "weight_decay": 1e-05,
    "gradient_clip": 1.0,
    "use_amp": false,
    "num_workers": 0,
    "seed": 42,
    "data_loading": {
      "mode": "ram",
      "max_cached_shards": 2,
      "large_shard_mmap_bytes": 134217728,
      "ram_safety_fraction": 0.8,
      "copy_mmap_slices": false,
      "use_device_prefetch": true
    },
    "model": {
      "d_model": 128,
      "nhead": 8,
      "num_layers": 4,
      "dim_feedforward": 384,
      "dropout": 0.0,
      "film_clamp": 10.0,
      "output_head_divisor": 2,
      "max_sequence_length": 64,
      "conditioning_hidden_dim": 128
    },
    "output_folder": "trained_model"
  }
