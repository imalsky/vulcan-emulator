{
  "paths": {
    "project_root": ".",
    "vulcan_source_path": "../VULCAN",
    "data_root": "data",
    "models_root": "models",
    "logs_root": "logs"
  },
  "generation": {
    "num_runs": 10,
    "num_workers": 1,
    "split_ratios": {
      "train": 0.8,
      "val": 0.1,
      "test": 0.1
    },
    "random_seed": 42,
    "keep_vulcan_outputs_debug": false,
    "failure_policy": "fail_on_first_error",
    "run_timeout_seconds": 900,
    "manifest_filename": "dataset_manifest.json",
    "split_filename": "splits.json",
    "shard_size": 256,
    "worker_root": "data/raw/_workers",
    "runs_root": "data/raw/runs",
    "save_evo_frq": 1
  },
  "trajectory_sampling": {
    "mode": "fixed_dt_post_equilibrium",
    "pairs_per_run": 256,
    "fixed_requested_dt_s": 1000000000000.0,
    "post_equilibrium_time_min_s": 1000000000000.0,
    "post_equilibrium_min_fraction_of_final_time": 0.0,
    "anchor_sampling": "uniform_valid_anchors",
    "target_selection": "nearest_saved_snapshot",
    "min_future_saved_steps": 1,
    "max_target_relative_dt_error": 0.5,
    "rollout_eval_points": 8
  },
  "vulcan_runtime": {
    "runtime": 1e+16,
    "dt_min": 1e-14,
    "dt_max": 1000000000000.0,
    "count_max": 200000,
    "trun_min": 100.0,
    "count_min": 120,
    "ini_mix": "EQ",
    "atm_base": "H2"
  },
  "tp_sampler": {
    "pressure_grid": {
      "nz": 12,
      "p_top_bar": 1e-08,
      "p_bottom_bar": 1000.0
    },
    "temperature_limits_k": {
      "min": 100.0,
      "max": 4000.0
    },
    "max_sampling_attempts": 32,
    "adiabatic_gradient": 0.286,
    "convective_adjustment_probability": 0.3333333333,
    "log10_kappa_ir": {
      "distribution": "uniform",
      "min": -2.5,
      "max": 2.5
    },
    "kappa_pressure_power_exponent": {
      "distribution": "uniform",
      "min": -0.5,
      "max": 1.0
    },
    "log10_gamma1": {
      "distribution": "uniform",
      "min": -2.0,
      "max": 2.0
    },
    "log10_gamma2": {
      "distribution": "uniform",
      "min": -2.0,
      "max": 2.0
    },
    "alpha_partition": {
      "distribution": "uniform",
      "min": 0.0,
      "max": 1.0
    },
    "t_int": {
      "distribution": "normal",
      "mean": 300.0,
      "std": 700.0,
      "min": 50.0,
      "max": 3000.0
    },
    "t_irr": {
      "distribution": "normal",
      "mean": 1800.0,
      "std": 500.0,
      "min": 200.0,
      "max": 4000.0
    },
    "temperature_shift": {
      "distribution": "uniform",
      "min": -600.0,
      "max": 600.0
    }
  },
  "gravity_sampler": {
    "distribution": "uniform",
    "min_cm_s2": 500.0,
    "max_cm_s2": 5000.0
  },
  "kzz_sampler": {
    "mode": "power_law_profile",
    "log10_kzz_at_1bar_min": 8.0,
    "log10_kzz_at_1bar_max": 10.0,
    "beta_min": 0.4,
    "beta_max": 0.6,
    "kzz_floor_cm2_s": 10000000.0,
    "kzz_cap_cm2_s": 1000000000000.0,
    "pressure_unit_for_profile": "bar"
  },
  "abundance_sampler": {
    "metallicity_mode": "log10_scale",
    "log10_metallicity_min": -0.5,
    "log10_metallicity_max": 1.0,
    "c_to_o_min": 0.3,
    "c_to_o_max": 1.2,
    "solar_abundances": {
      "O_H": 0.000537,
      "N_H": 7.08e-05,
      "He_H": 0.0838,
      "S_H": 1.41e-05
    }
  },
  "physics_toggles": {
    "use_photochemistry": false,
    "use_ion_chemistry": false,
    "use_eddy_diffusion": true,
    "use_molecular_diffusion": true,
    "use_upwind_molecular_diffusion": false,
    "use_boundary_conditions": false,
    "use_condensation": true,
    "use_settling": true,
    "use_initial_cold_trap": true,
    "use_sat_surface_h2o": false,
    "use_lowT_limit_rates": false,
    "use_adaptive_rtol": true
  },
