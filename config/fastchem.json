{
  "chemistry_type": "fastchem",
  "model_type": "transformer",
  "paths": {
    "run_root": "data/fastchem",
    "checkpoints_root": "models/fastchem",
    "vulcan_source_root": "../VULCAN-master"
  },
  "data_spec": {
    "state_species": [
      "H2", "He", "H", "O", "OH", "H2O", "CO", "CO2", "CH4",
      "N2", "NH3", "H2S", "SH", "S", "SO", "SO2", "S2"
    ],
    "output_species": [
      "H2", "He", "H", "O", "OH", "H2O", "CO", "CO2", "CH4",
      "N2", "NH3", "H2S", "SH", "S", "SO", "SO2", "S2"
    ]
  },
  "sampling": {
    "num_levels_range": [40, 60],
    "pressure_top_bar_range": [1.0e-06, 1.0e-05],
    "pressure_bottom_bar_range": [100.0, 200.0],
    "temperature_range_k": [100.0, 3000.0],
    "he_frac_range": [5e-02, 3e-01],
    "c_frac_range": [4.22e-05, 3.0e-03],
    "o_frac_range": [7.17e-05, 5.5e-03],
    "n_frac_range": [9.89e-06, 7.5e-04],
    "s_frac_range": [1.93e-06, 1.5e-04],
    "scales": {
      "he_frac": "log",
      "c_frac": "log",
      "o_frac": "log",
      "n_frac": "log",
      "s_frac": "log"
    }
  },
  "temperature_profiles": {
    "source_mode": "mixed",
    "analytic_probability": 0.7,
    "data_glob": "assets/PTprofiles/*.dat",
    "filters": {
      "Teq": [600.0, 2800.0],
      "LogMet": [-0.5, 1.5]
    },
    "validation": {
      "min_temperature_k": 1.0,
      "max_temperature_k": 3000.0
    },
    "analytic_sampler": {
      "t_int_k_range": [1.0, 1000.0],
      "t_eq_k_range": [1.0, 3000.0],
      "log10_delta_range": [-6, 2],
      "log10_gamma_range": [-4.0, 4.0],
      "alpha_range": [0.0, 0.999],
      "log10_p_trans_bar_range": [-9.0, 3.0],
      "convection_probability": 0.1,
      "adiabatic_gradient_range": [0.25, 0.35],
      "power_law_probability": 0.40,
      "power_law_t0_range_k": [600.0, 2400.0],
      "power_law_alpha_range": [0.0, 0.25],
      "power_law_p_ref_bar": 1.0
    }
  },
  "generation": {
    "num_runs": 500000,
    "seed": 1,
    "overwrite": false,
    "reuse_raw_if_present": true,
    "parallel_workers": 64,
    "sample_chunk_size": 1000,
    "backfill": {
      "enabled": true,
      "max_retries": 5
    }
  },
  "normalization": {
    "split": {
      "train_fraction": 0.8,
      "val_fraction": 0.1,
      "test_fraction": 0.1,
      "seed": 123
    },
    "state_floor": 1e-30,
    "target_method": "log-standard",
    "sequence_methods": {
      "pressure_bar": "log-minmax",
      "temperature_k": "standard"
    },
    "global_methods": {
      "He_H": "log-standard",
      "C_H": "log-standard",
      "O_H": "log-standard",
      "N_H": "log-standard",
      "S_H": "log-standard"
    }
  },
  "training": {
    "seed": 123,
    "batch_size": 256,
    "epochs": 200,
    "learning_rate": 0.0003,
    "min_lr": 1e-06,
    "warmup_epochs": 20,
    "early_stopping_patience": 20,
    "scheduler": {
      "name": "reduce_on_plateau",
      "factor": 0.5,
      "patience": 10,
      "threshold": 0.0001
    },
    "weight_decay": 1e-04,
    "gradient_clip": 1.0,
    "loss": {
      "type": "mae",
      "lambda_z": 1.0,
      "lambda_log10_mae": 0.25
    },
    "ema": {
      "enabled": true,
      "decay": 0.999
    }
  },
  "model": {
    "d_model": 256,
    "nhead": 4,
    "num_layers": 6,
    "dim_feedforward": 1024,
    "conditioning_hidden_dim": 256,
    "film_clamp": 100.0,
    "output_head_divisor": 2,
    "activation": "silu",
    "dropout_rate": 0.0,
    "norm_type": "layernorm",
    "use_qk_norm": false,
    "ffn_type": "dense",
    "zero_init_film": false
  }
}
