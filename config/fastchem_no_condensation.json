{

  "chemistry_type": "fastchem",
  "model_type": "transformer",
  "paths": {
    "run_root": "data/fastchem_no_condensation",
    "checkpoints_root": "models/fastchem_no_condensation",
    "vulcan_source_root": "../VULCAN-master"
  },
  "data_spec": {
    "state_species": [
      "H2", "He", "H", "O", "OH", "H2O", "CO", "CO2", "CH4",
      "N2", "NH3", "H2S", "SH", "S", "SO", "SO2", "S2"
    ],
    "output_species": [
      "H2", "He", "H", "O", "OH", "H2O", "CO", "CO2", "CH4",
      "N2", "NH3", "H2S", "SH", "S", "SO", "SO2", "S2"
    ]
  },
  "sampling": {
    "num_levels_range": [40, 60],
    "pressure_top_bar_range": [1e-07, 1e-05],
    "pressure_bottom_bar_range": [50.0, 500.0],
    "temperature_range_k": [100.0, 3500.0],
    "he_frac_range":  [0.030,   0.180],
    "c_frac_range":   [2.7e-05, 2.7e-03],
    "o_frac_range":   [4.5e-05, 4.5e-03],
    "n_frac_range":   [6.2e-06, 6.2e-04],
    "s_frac_range":   [1.2e-06, 1.2e-04],
    "scales": {
      "he_frac": "linear",
      "c_frac":  "log",
      "o_frac":  "log",
      "n_frac":  "log",
      "s_frac":  "log"
    }
  },
  "temperature_profiles": {
    "source_mode": "mixed",
    "analytic_probability": 0.8,
    "data_glob": "assets/PTprofiles/*.dat",
    "filters": {
      "Teq": [600.0, 2800.0],
      "LogMet": [-0.5, 1.0],
      "TiOVO": false
    },
    "validation": {
      "min_temperature_k": 100.0,
      "max_temperature_k": 3500.0
    },
    "analytic_sampler": {
      "t_int_k_range": [50.0, 1000.0],
      "t_eq_k_range": [300.0, 3500.0],
      "log10_delta_range": [-3.0, 1.0],
      "log10_gamma_range": [-1.0, 1.0],
      "alpha_range": [0.0, 0.9],
      "log10_p_trans_bar_range": [-2.0, 2.0],
      "convection_probability": 0.2,
      "adiabatic_gradient_range": [0.25, 0.35]
    }
  },
  "generation": {
    "num_runs": 50000,
    "seed": 1,
    "overwrite": false,
    "reuse_raw_if_present": true,
    "parallel_workers": 0,
    "sample_chunk_size": 1000,
    "backfill": {
      "enabled": true,
      "max_retries": 3
    }
  },
  "normalization": {
    "split": {
      "train_fraction": 0.8,
      "val_fraction": 0.1,
      "test_fraction": 0.1,
      "seed": 123
    },
    "state_floor": 1e-30,
    "target_method": "log-standard",
    "sequence_methods": {
      "pressure_bar": "log-minmax",
      "temperature_k": "standard"
    },
    "global_methods": {
      "He_H": "log-standard",
      "C_H": "log-standard",
      "O_H": "log-standard",
      "N_H": "log-standard",
      "S_H": "log-standard"
    }
  },
  "training": {
    "seed": 123,
    "batch_size": 512,
    "epochs": 400,
    "learning_rate": 0.0003,
    "min_lr": 1e-06,
    "warmup_epochs": 20,
    "early_stopping_patience": 40,
    "scheduler": {
      "name": "reduce_on_plateau",
      "factor": 0.5,
      "patience": 15,
      "threshold": 0.0001
    },
    "weight_decay": 1e-04,
    "gradient_clip": 1.0,
    "loss": {
      "type": "mae",
      "lambda_z": 1.0,
      "lambda_log10_mae": 0.25
    },
    "ema": {
      "enabled": true,
      "decay": 0.999
    }
  },
  "model": {
    "d_model": 256,
    "nhead": 8,
    "num_layers": 6,
    "dim_feedforward": 1024,
    "conditioning_hidden_dim": 256,
    "film_clamp": 100.0,
    "output_head_divisor": 2,
    "activation": "silu",
    "dropout_rate": 0.0,
    "norm_type": "rmsnorm",
    "use_qk_norm": false,
    "ffn_type": "dense",
    "zero_init_film": false
  }
}
