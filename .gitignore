# Byte-compiled / optimized
__pycache__/
*.py[codz]
*$py.class
*.so

# Distribution / packaging
build/
dist/
*.egg-info/
*.egg

# Unit test / coverage
htmlcov/
.coverage
.coverage.*
.pytest_cache/
coverage.xml

# Environments
.env
.venv
venv/

# IDEs and editors
.idea/
.vscode/
.cursorignore
.cursorindexingignore
.claude/settings.local.json

# Type checkers / linters
.mypy_cache/
.ruff_cache/
.pytype/

# Jupyter
.ipynb_checkpoints

# macOS
.DS_Store

# Transient staging directories for chemistry subprocess execution
runtime/

# Immutable external assets are user-managed and not tracked.
assets/**
!assets/prebake_pt_profiles.py

# Keep checked-in pipeline configs visible even if broader local/global
# ignore rules exist on a given machine.
!config/
!config/*.json
!config/*.md

# Vulcan-emulator generated artifacts (data, models, logs)
data/*
data/**/raw/
data/**/dataset_manifest.json
data/**/splits.json
/models/
logs/

# Model checkpoints and serialized objects
*.pt
*.pt2
*.pth
*.ckpt
*.onnx
*.pkl
*.pickle

# Large binary / array artifacts
*.h5
*.npy
*.npz
*.vul

# ExoJAX-managed external opacity tables (HITRAN CIA, ExoMol line lists,
# partition functions). Auto-downloaded by MdbExomol / CdbCIA on first
# use — never commit them. Matches `.database/` at any depth.
.database/

# Images / plot outputs
*.png
*.jpg
*.jpeg
*.gif
plots/
extras/plots/
extras/standalone_plots/

# Log files
*.log

# Large demo artifacts
*.zip
