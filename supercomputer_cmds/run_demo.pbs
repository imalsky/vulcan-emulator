#!/bin/bash
#PBS -N vulcan_demo
#PBS -q gpu_long
#PBS -W group_list=s2458
#PBS -l select=1:ncpus=72:ngpus=1:mem=400gb:model=gh200
#PBS -l walltime=10:00:00
#PBS -j oe
#PBS -m abe

# =============================================================================
# VULCAN Emulator Demo -- PBS Submission Script
#
# Executes every notebook in exojax_demo/ on a GPU node, in numbered order.
# Each notebook is overwritten in-place with executed outputs.
#
# Usage (submit from anywhere; the script self-locates the project root):
#   qsub supercomputer_cmds/run_demo.pbs
#   qsub -v MODEL=fastchem supercomputer_cmds/run_demo.pbs
#   qsub -v MODEL=fastchem,NOTEBOOK=02_chemistry_comparison.ipynb \
#        supercomputer_cmds/run_demo.pbs
# =============================================================================

set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
PROJECT_ROOT="${PROJECT_ROOT:-$(cd -- "${SCRIPT_DIR}/.." && pwd -P)}"
cd -P "${PROJECT_ROOT}"

LOG_ROOT="${LOG_ROOT:-${PROJECT_ROOT}/logs}"
mkdir -p "${LOG_ROOT}"

# --- Conda Environment ---
module purge
module use -a /swbuild/analytix/tools/modulefiles
module load miniconda3/gh2

CONDA_BASE="$(conda info --base)"
# shellcheck disable=SC1090
source "${CONDA_BASE}/etc/profile.d/conda.sh"
conda activate "${CONDA_ENV:-pyt2_8_gh}"

# --- Configuration ---
MODEL="${MODEL:-fastchem}"

# --- Environment ---
export HDF5_USE_FILE_LOCKING=FALSE
export PYTHONPATH="${PROJECT_ROOT}/src:${PROJECT_ROOT}:${PYTHONPATH:-}"
export PYTHONUNBUFFERED=1
export JAX_ENABLE_X64="${JAX_ENABLE_X64:-1}"
export XLA_PYTHON_CLIENT_PREALLOCATE="${XLA_PYTHON_CLIENT_PREALLOCATE:-true}"
export XLA_PYTHON_CLIENT_MEM_FRACTION="${XLA_PYTHON_CLIENT_MEM_FRACTION:-0.90}"
export MPLBACKEND="${MPLBACKEND:-Agg}"
export XLA_FLAGS="${XLA_FLAGS:-} --xla_gpu_enable_triton_gemm=false --xla_gpu_autotune_level=0"

# The notebooks read this environment variable to select the bundle directory.
export VULCAN_DEMO_MODEL="${MODEL}"

echo "MODEL=${MODEL}"

if [ -n "${PBS_JOBID:-}" ]; then
  export VULCAN_LIVE_LOG_PATH="${VULCAN_LIVE_LOG_PATH:-${LOG_ROOT}/pbs_${PBS_JOBID}.log}"
  touch "${VULCAN_LIVE_LOG_PATH}"
  echo "Live log: ${VULCAN_LIVE_LOG_PATH}"
fi

# Run a single notebook if NOTEBOOK is set, otherwise run them all in order.
if [ -n "${NOTEBOOK:-}" ]; then
  TARGETS=("exojax_demo/${NOTEBOOK}")
else
  TARGETS=(exojax_demo/0?_*.ipynb)
fi

for nb in "${TARGETS[@]}"; do
  echo "=== executing ${nb} ==="
  jupyter nbconvert \
    --to notebook --execute --inplace \
    --ExecutePreprocessor.timeout=14400 \
    "${nb}"
done
