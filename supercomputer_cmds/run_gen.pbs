#!/bin/bash
#PBS -N vulcan_gen
#PBS -q gpu_long
#PBS -W group_list=s2458
#PBS -l select=1:ncpus=72:ngpus=1:mem=400gb:model=gh200
#PBS -l walltime=10:00:00
#PBS -j oe
#
# =============================================================================
# Single-node, CPU-parallel VULCAN-JAX generation for the 100k Luhman 16A set.
#
# 72 worker subprocesses, each a single-threaded vulcan_jax run (the GH200's 72
# Grace cores). Generation RESUMES from already-consolidated chunks, and this job
# SELF-RESUBMITS (PBS depend=afterany) until all num_runs are present — so 100k
# completes across as many 10h jobs as it takes, with no manual babysitting.
# (The GPU on the node is idle during generation; that's unavoidable because the
#  vulcan_jax/FastChem binaries are aarch64 and only GH200 nodes are aarch64.)
#
#   cd /nobackup/$USER/vulcan-emulator
#   qsub supercomputer_cmds/run_gen.pbs
#
# When it prints "generation COMPLETE", run:  qsub supercomputer_cmds/run_train.pbs
#
# Env (-v):
#   CONFIG_PATH        default config/vulcan_luhman16a_100k.json
#   GEN_AUTORESUBMIT   1 (default) self-chain until complete; 0 = one job only
#   GEN_MAX_ATTEMPTS   safety cap on the self-chain (default 15)
#   GEN_ATTEMPT        internal chain counter — do not set by hand
#   CONDA_ENV, VULCAN_SCRATCH   as in run_install
# =============================================================================
set -uo pipefail

# --- locate the repo (PBS spools the script; use PBS_O_WORKDIR) ---------------
if [ -n "${PROJECT_ROOT:-}" ]; then :
elif [ -n "${PBS_O_WORKDIR:-}" ] && [ -d "${PBS_O_WORKDIR}/supercomputer_cmds" ]; then
  PROJECT_ROOT="${PBS_O_WORKDIR}"
elif [ -n "${PBS_O_WORKDIR:-}" ] && [ "$(basename "${PBS_O_WORKDIR}")" = "supercomputer_cmds" ]; then
  PROJECT_ROOT="$(cd -- "${PBS_O_WORKDIR}/.." && pwd -P)"
else
  _sd="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"; PROJECT_ROOT="$(cd -- "${_sd}/.." && pwd -P)"
fi
if [ ! -d "${PROJECT_ROOT}/supercomputer_cmds" ]; then
  echo "ERROR: submit from the repo root: cd /nobackup/\$USER/vulcan-emulator && qsub supercomputer_cmds/run_gen.pbs"
  exit 1
fi
cd -P "${PROJECT_ROOT}"
SCRIPT_DIR="${PROJECT_ROOT}/supercomputer_cmds"

CONFIG_PATH="${CONFIG_PATH:-config/vulcan_luhman16a_100k.json}"
[ -f "${CONFIG_PATH}" ] || { echo "ERROR: config not found: ${CONFIG_PATH}"; exit 1; }
GEN_AUTORESUBMIT="${GEN_AUTORESUBMIT:-1}"
GEN_ATTEMPT="${GEN_ATTEMPT:-1}"
GEN_MAX_ATTEMPTS="${GEN_MAX_ATTEMPTS:-15}"

# --- caches off $HOME, conda, vulcan_jax + FastChem ready ---------------------
# shellcheck source=/dev/null
source "${SCRIPT_DIR}/hpc_env.sh"
module purge 2>/dev/null || true
module use -a /swbuild/analytix/tools/modulefiles 2>/dev/null || true
module load miniconda3/gh2 2>/dev/null || true
# shellcheck disable=SC1090
source "$(conda info --base)/etc/profile.d/conda.sh"
conda activate "${CONDA_ENV:-pyt2_8_gh}"
"${SCRIPT_DIR}/ensure_vulcan_jax.sh"

# --- generation runtime env --------------------------------------------------
# Keep every vulcan_jax worker single-threaded so 72 of them don't oversubscribe
# the 72 cores. generation.py already forces JAX_PLATFORMS=cpu per worker.
export PYTHONPATH="${PROJECT_ROOT}/src:${PROJECT_ROOT}:${PYTHONPATH:-}"
export PYTHONUNBUFFERED=1
export HDF5_USE_FILE_LOCKING=FALSE
export JAX_ENABLE_X64=1
export OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1 NUMEXPR_NUM_THREADS=1
export XLA_FLAGS="--xla_cpu_multi_thread_eigen=false"

echo "config=${CONFIG_PATH}  attempt=${GEN_ATTEMPT}/${GEN_MAX_ATTEMPTS}  node=$(hostname)  arch=$(uname -m)"

# --- completion check (consolidated runs.h5 vs num_runs) ---------------------
read -r EXPECTED COUNT < <(python - "${CONFIG_PATH}" <<'PY'
import json, sys, pathlib
cfg = json.load(open(sys.argv[1]))
rr = pathlib.Path(str(cfg["paths"]["run_root"]))
if not rr.is_absolute(): rr = (pathlib.Path.cwd() / rr).resolve()
runs = rr / "raw" / "runs.h5"
n = int(cfg["generation"]["num_runs"]); c = 0
if runs.exists():
    import h5py
    with h5py.File(runs, "r") as h: c = len(h.keys())
print(n, c)
PY
)
echo "generation: ${COUNT}/${EXPECTED} runs already consolidated."
if [ "${COUNT}" -ge "${EXPECTED}" ]; then
  echo "generation COMPLETE — next: qsub supercomputer_cmds/run_train.pbs"
  exit 0
fi

# --- self-chain: queue a successor that starts when this job ends (afterany),
#     so a walltime-killed job is automatically continued. The successor's own
#     completion check above makes it a no-op once generation finishes; the
#     attempt cap prevents a runaway chain. ------------------------------------
if [ "${GEN_AUTORESUBMIT}" = "1" ] && [ "${GEN_ATTEMPT}" -lt "${GEN_MAX_ATTEMPTS}" ] && [ -n "${PBS_JOBID:-}" ]; then
  NEXT=$((GEN_ATTEMPT + 1))
  if qsub -W depend=afterany:"${PBS_JOBID}" \
          -v "CONFIG_PATH=${CONFIG_PATH},GEN_ATTEMPT=${NEXT},GEN_MAX_ATTEMPTS=${GEN_MAX_ATTEMPTS},GEN_AUTORESUBMIT=1" \
          "${SCRIPT_DIR}/run_gen.pbs" 2>/tmp/vulcan_gen_qsub.err; then
    echo "queued successor gen job (attempt ${NEXT}, depend=afterany:${PBS_JOBID})."
  else
    echo "WARNING: could not queue successor (in-job qsub blocked?): $(cat /tmp/vulcan_gen_qsub.err 2>/dev/null)"
    echo "         when this job ends, resume manually: qsub supercomputer_cmds/run_gen.pbs"
  fi
elif [ "${GEN_ATTEMPT}" -ge "${GEN_MAX_ATTEMPTS}" ]; then
  echo "NOTE: reached GEN_MAX_ATTEMPTS=${GEN_MAX_ATTEMPTS}; not self-chaining further."
  echo "      If still incomplete after this job, resubmit: qsub supercomputer_cmds/run_gen.pbs"
fi

# --- run generation (resumes from existing chunks/per-run files) -------------
echo "========== Stage: generation =========="
python -u -m src.utils --config "${CONFIG_PATH}" --stage generation
echo "generation stage returned."
