#!/bin/bash
#PBS -N vulcan_gen
#PBS -q gpu_long
#PBS -W group_list=s2458
#PBS -l select=1:ncpus=72:ngpus=1:mem=400gb:model=gh200
#PBS -l walltime=10:00:00
#PBS -j oe
#
# =============================================================================
# Single-node VULCAN-JAX generation for the 100k Luhman 16A set.
#
# Uses the GH200's H100 GPU when one is usable: by default it auto-detects the
# GPU and runs the in-process vmap-across-profiles path (OuterLoop.run_batch),
# integrating whole (nz, toggle-combo) buckets in one device call. If no GPU is
# visible it falls back to 72 single-threaded vulcan_jax subprocesses on the
# Grace cores. This submits ONE job — no self-resubmit / dependency chain.
# Generation RESUMES from already-consolidated chunks, so if the job is killed
# at walltime before num_runs is reached, just resubmit to continue.
#
#   cd /nobackup/$USER/vulcan-emulator
#   qsub supercomputer_cmds/run_gen.pbs
#
# When it prints "generation COMPLETE", run:  qsub supercomputer_cmds/run_train.pbs
#
# Env (-v):
#   CONFIG_PATH        default config/vulcan_luhman16a_100k.json
#   GEN_GPU_BATCH      auto (default) use GPU if usable; 1 force GPU; 0 force CPU
#   GEN_HOST_SETUP_WORKERS  GPU mode only: size of the CPU pool that builds
#                      profiles (FastChem) to feed the GPU. unset/0 = auto
#                      (detect the Grace cores).
#   CONDA_ENV, VULCAN_SCRATCH   as in run_install
# =============================================================================
set -uo pipefail

# --- locate the repo (PBS spools the script; use PBS_O_WORKDIR) ---------------
if [ -n "${PROJECT_ROOT:-}" ]; then :
elif [ -n "${PBS_O_WORKDIR:-}" ] && [ -d "${PBS_O_WORKDIR}/supercomputer_cmds" ]; then
  PROJECT_ROOT="${PBS_O_WORKDIR}"
elif [ -n "${PBS_O_WORKDIR:-}" ] && [ "$(basename "${PBS_O_WORKDIR}")" = "supercomputer_cmds" ]; then
  PROJECT_ROOT="$(cd -- "${PBS_O_WORKDIR}/.." && pwd -P)"
else
  _sd="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"; PROJECT_ROOT="$(cd -- "${_sd}/.." && pwd -P)"
fi
if [ ! -d "${PROJECT_ROOT}/supercomputer_cmds" ]; then
  echo "ERROR: submit from the repo root: cd /nobackup/\$USER/vulcan-emulator && qsub supercomputer_cmds/run_gen.pbs"
  exit 1
fi
cd -P "${PROJECT_ROOT}"
SCRIPT_DIR="${PROJECT_ROOT}/supercomputer_cmds"

CONFIG_PATH="${CONFIG_PATH:-config/vulcan_luhman16a_100k.json}"
[ -f "${CONFIG_PATH}" ] || { echo "ERROR: config not found: ${CONFIG_PATH}"; exit 1; }

# --- caches off $HOME, conda, vulcan_jax + FastChem ready ---------------------
# shellcheck source=/dev/null
source "${SCRIPT_DIR}/hpc_env.sh"
module purge 2>/dev/null || true
module use -a /swbuild/analytix/tools/modulefiles 2>/dev/null || true
module load miniconda3/gh2 2>/dev/null || true
# shellcheck disable=SC1090
source "$(conda info --base)/etc/profile.d/conda.sh"
conda activate "${CONDA_ENV:-pyt2_8_gh}"
"${SCRIPT_DIR}/ensure_vulcan_jax.sh"

# --- generation mode: use the GPU if one is usable, else the CPU pool --------
# GEN_GPU_BATCH selects the in-process vmapped GPU path (OuterLoop.run_batch on
# the GH200 H100) vs the 72-core CPU subprocess pool:
#   auto (default) — use the GPU when JAX can see one, else fall back to CPU
#   1              — force the GPU path (hard-fail below if no usable GPU)
#   0              — force the CPU subprocess pool
# Only the vulcan_jax backend has a GPU path; generation.py gates on that, so
# this just exports VULCAN_GEN_GPU_BATCH for the pipeline to honor.
GEN_GPU_BATCH="${GEN_GPU_BATCH:-auto}"

# A GPU is "usable" iff nvidia-smi works AND JAX actually lands on it. Probed in
# a subshell with JAX_PLATFORMS unset so JAX auto-selects the device.
gpu_usable() {
  command -v nvidia-smi >/dev/null 2>&1 && nvidia-smi >/dev/null 2>&1 || return 1
  ( unset JAX_PLATFORMS; python - >/dev/null 2>&1 <<'PY'
import jax, sys
sys.exit(0 if jax.default_backend() in ("gpu", "cuda", "rocm") else 1)
PY
  )
}

if [ "${GEN_GPU_BATCH}" = "0" ]; then
  USE_GPU=0
elif [ "${GEN_GPU_BATCH}" = "1" ]; then
  USE_GPU=1
elif gpu_usable; then
  USE_GPU=1
else
  USE_GPU=0
fi

# --- generation runtime env --------------------------------------------------
export PYTHONPATH="${PROJECT_ROOT}/src:${PROJECT_ROOT}:${PYTHONPATH:-}"
export PYTHONUNBUFFERED=1
export HDF5_USE_FILE_LOCKING=FALSE
export JAX_ENABLE_X64="${JAX_ENABLE_X64:-1}"
if [ "${USE_GPU}" = "1" ]; then
  # GPU-batched: integrate buckets on the H100 while a spawn ProcessPool builds
  # the next profiles (FastChem) across the Grace cores. Use the GPU runtime env
  # (NOT the CPU pin); the host-setup workers pin THEMSELVES to CPU. Do not cap
  # host threads here — the pool wants the cores for NumPy/FastChem setup.
  export VULCAN_GEN_GPU_BATCH=1
  if [ -n "${GEN_HOST_SETUP_WORKERS:-}" ]; then
    export VULCAN_GEN_HOST_SETUP_WORKERS="${GEN_HOST_SETUP_WORKERS}"
  fi
  unset JAX_PLATFORMS
  export XLA_PYTHON_CLIENT_PREALLOCATE="${XLA_PYTHON_CLIENT_PREALLOCATE:-true}"
  export XLA_PYTHON_CLIENT_MEM_FRACTION="${XLA_PYTHON_CLIENT_MEM_FRACTION:-0.90}"
  export XLA_FLAGS="${XLA_FLAGS:---xla_gpu_enable_triton_gemm=false --xla_gpu_autotune_level=0}"
  echo "config=${CONFIG_PATH}  mode=gpu-batched  node=$(hostname)  arch=$(uname -m)"
  if ! command -v nvidia-smi >/dev/null 2>&1 || ! nvidia-smi >/dev/null 2>&1; then
    echo "ERROR: GEN_GPU_BATCH=1 but no visible NVIDIA GPU in this job."; exit 1
  fi
  python - <<'PY' || { echo "ERROR: JAX is not on the GPU — gpu-batched generation would fall back to CPU."; exit 1; }
import jax, sys
be = jax.default_backend()
print(f"jax {jax.__version__}  backend={be}  devices={jax.devices()}")
sys.exit(0 if be in ("gpu", "cuda", "rocm") else 1)
PY
else
  # CPU subprocess pool: single-threaded workers so 72 of them don't
  # oversubscribe the 72 Grace cores. generation.py forces JAX_PLATFORMS=cpu
  # per worker; the H100 is idle in this mode.
  export VULCAN_GEN_GPU_BATCH=0
  export OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1 NUMEXPR_NUM_THREADS=1
  export XLA_FLAGS="--xla_cpu_multi_thread_eigen=false"
  echo "config=${CONFIG_PATH}  mode=cpu-subprocess  node=$(hostname)  arch=$(uname -m)"
fi

# --- completion check (consolidated runs.h5 vs num_runs) ---------------------
read -r EXPECTED COUNT < <(python - "${CONFIG_PATH}" <<'PY'
import json, sys, pathlib
cfg = json.load(open(sys.argv[1]))
rr = pathlib.Path(str(cfg["paths"]["run_root"]))
if not rr.is_absolute(): rr = (pathlib.Path.cwd() / rr).resolve()
runs = rr / "raw" / "runs.h5"
n = int(cfg["generation"]["num_runs"]); c = 0
if runs.exists():
    import h5py
    with h5py.File(runs, "r") as h: c = len(h.keys())
print(n, c)
PY
)
echo "generation: ${COUNT}/${EXPECTED} runs already consolidated."
if [ "${COUNT}" -ge "${EXPECTED}" ]; then
  echo "generation COMPLETE — next: qsub supercomputer_cmds/run_train.pbs"
  exit 0
fi

# --- run generation (resumes from existing chunks/per-run files) -------------
# Single job: no successor is queued. If this is killed at walltime before
# num_runs is reached, resume by resubmitting: qsub supercomputer_cmds/run_gen.pbs
echo "========== Stage: generation =========="
python -u -m src.utils --config "${CONFIG_PATH}" --stage generation
echo "generation stage returned."
