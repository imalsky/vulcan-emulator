#!/bin/bash
#PBS -N vjax_gpu_bench
#PBS -q gpu_long
#PBS -W group_list=s2458
#PBS -l select=1:ncpus=72:ngpus=1:mem=400gb:model=gh200
#PBS -l walltime=01:00:00
#PBS -j oe
#
# =============================================================================
# Standalone VULCAN-JAX GPU throughput benchmark on a GH200 (H100) node.
#
# Integrates a batch of HD 189-like planets (the vendored HD189 T-P + Kzz
# atmosphere, each planet's T(P) scaled by a few percent, FastChem-EQ init,
# photo off) in one vmapped device call (OuterLoop.run_batch). Converges in
# ~600 steps/planet, so the default 4-planet test finishes in a few minutes.
# For the paper's throughput-vs-batch-size sweep:
#   qsub -v BATCHES="8 64 256 512" supercomputer_cmds/run_gpu_benchmark.pbs
#
#   cd /nobackup/$USER/vulcan-emulator
#   qsub supercomputer_cmds/run_gpu_benchmark.pbs
#
# LIVE PROGRESS: PBS only delivers the .o file when the job ends, so this
# script also streams everything to a log file you can watch while it runs:
#
#   tail -f /nobackup/$USER/vulcan-emulator/logs/vjax_gpu_bench_<jobid>.log
#
# It runs the self-contained script supercomputer_cmds/gpu_benchmark.py, which
# imports only the installed `vulcan_jax` (the HD189 atm file and the FastChem
# binary ship inside the package; no sibling repos). vulcan-jax must already be
# installed in the env (see run_install.pbs
# or just `pip install --user vulcan-jax`). Host setup (RunState builds) fans
# out across all 72 Grace cores on a CPU-pinned spawn pool and overlaps with
# the GPU integration; the GPU integration itself is driven in CHUNK-step
# device calls so a progress line appears every chunk.
#
# Env (-v):
#   BATCHES    batch sizes to sweep (default "4" = the quick test; 1024
#              OOMs the 96 GB H100 — stack_integ_states' eager jnp.stack of
#              the (conv_step=500, nz, ni) y_time_ring leaf transiently
#              needs ~90+ GB at that size)
#   NZ         layers per planet (default 150 = the real HD189 config)
#   COUNT_MAX  Ros2 step cap per planet (default 2500; this regime converges
#              in ~600 steps — the old synthetic const_mix benchmark needed
#              ~4100, which with its 2000-step cap is why the first run
#              "converged" 0/512)
#   CHUNK      accepted steps per device call / progress-log cadence
#              (default 250)
#   WORKERS    host-setup CPU processes (default 0 = all visible cores)
#   DEVICE_BATCH  max lanes per device call (default 128; larger sweep batches
#              run as sequential tiles sharing one XLA compile)
#   PROBE      1 = after the sweep, run an UNTILED Fix-B memory probe in a
#              fresh process (default 1). The probe verifies the chunked
#              Jacobian assembly (vulcan-jax >= 0.1.14) bounds the vmapped
#              transient on device: watch the per-batch 'peak GiB' column.
#   PROBE_BATCH  probe size, or "auto" by GPU memory (default auto;
#              ~0.17 GiB/lane healthy -> 512 needs ~87 GiB, the ceiling probe
#              on the 96 GB GH200, where an OOM is a non-fatal FINDING)
#   CONDA_ENV  interpreter env (default pyt2_8_gh)
# =============================================================================
set -uo pipefail

# --- locate the repo (PBS spools the script; use PBS_O_WORKDIR) ---------------
if [ -n "${PROJECT_ROOT:-}" ]; then :
elif [ -n "${PBS_O_WORKDIR:-}" ] && [ -d "${PBS_O_WORKDIR}/supercomputer_cmds" ]; then
  PROJECT_ROOT="${PBS_O_WORKDIR}"
elif [ -n "${PBS_O_WORKDIR:-}" ] && [ "$(basename "${PBS_O_WORKDIR}")" = "supercomputer_cmds" ]; then
  PROJECT_ROOT="$(cd -- "${PBS_O_WORKDIR}/.." && pwd -P)"
else
  _sd="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"; PROJECT_ROOT="$(cd -- "${_sd}/.." && pwd -P)"
fi
if [ ! -d "${PROJECT_ROOT}/supercomputer_cmds" ]; then
  echo "ERROR: submit from the repo root: cd /nobackup/\$USER/vulcan-emulator && qsub supercomputer_cmds/run_gpu_benchmark.pbs"
  exit 1
fi
cd -P "${PROJECT_ROOT}"
SCRIPT_DIR="${PROJECT_ROOT}/supercomputer_cmds"

# --- stream all output to a tail-able log (PBS .o only appears at job end) ----
LOG_DIR="${PROJECT_ROOT}/logs"
mkdir -p "${LOG_DIR}"
_jobid="${PBS_JOBID:-manual_$$}"
LOG_FILE="${LOG_DIR}/vjax_gpu_bench_${_jobid%%.*}.log"
exec > >(tee -a "${LOG_FILE}") 2>&1
echo "Live log: tail -f ${LOG_FILE}"
echo "Job ${PBS_JOBID:-?} started $(date)"

# --- caches off $HOME, conda, vulcan_jax + FastChem ready ---------------------
# shellcheck source=/dev/null
source "${SCRIPT_DIR}/hpc_env.sh"
module purge 2>/dev/null || true
module use -a /swbuild/analytix/tools/modulefiles 2>/dev/null || true
module load miniconda3/gh2 2>/dev/null || true
# shellcheck disable=SC1090
source "$(conda info --base)/etc/profile.d/conda.sh"
conda activate "${CONDA_ENV:-pyt2_8_gh}"

# vulcan_jax must be importable AND new enough to carry BOTH the make_config
# cfg= wiring (>=0.1.13) and the chunked-Jacobian "Fix B" + run_batch host-side
# tiling "Fix A" that phases 1-2 below exercise (>=0.1.14). On an older build the
# tiled sweep and the Fix-B probe are meaningless, so gate on the version tuple
# (mirrors run_gpu_benchmark.sh) and keep the cfg= signature check as a backstop.
python - <<'PY' || { echo "       Upgrade with:  qsub -v FORCE=1 supercomputer_cmds/run_install.pbs"; exit 1; }
import sys, inspect
import vulcan_jax
from vulcan_jax import legacy_io
ver = tuple(int(x) for x in vulcan_jax.__version__.split(".")[:3])
print("vulcan_jax", vulcan_jax.__version__)
if ver < (0, 1, 14):
    sys.exit(f"ERROR: vulcan_jax {vulcan_jax.__version__} predates the chunked "
             "Jacobian (Fix B) + run_batch tiling (Fix A); the tiled sweep and "
             "Fix-B probe need >= 0.1.14.")
if "cfg" not in inspect.signature(legacy_io.Output.__init__).parameters:
    sys.exit(f"ERROR: vulcan_jax {vulcan_jax.__version__} lacks the make_config "
             "cfg= wiring the benchmark's standalone config relies on.")
PY

# --- GPU runtime env (same knobs as run_gen.pbs's GPU branch) -----------------
export PYTHONUNBUFFERED=1
export JAX_ENABLE_X64="${JAX_ENABLE_X64:-1}"
unset JAX_PLATFORMS
export JAX_PLATFORM_NAME=gpu
export XLA_PYTHON_CLIENT_PREALLOCATE="${XLA_PYTHON_CLIENT_PREALLOCATE:-true}"
export XLA_PYTHON_CLIENT_MEM_FRACTION="${XLA_PYTHON_CLIENT_MEM_FRACTION:-0.90}"
export XLA_FLAGS="${XLA_FLAGS:---xla_gpu_enable_triton_gemm=false --xla_gpu_autotune_level=0}"

echo "node=$(hostname)  arch=$(uname -m)"
if ! command -v nvidia-smi >/dev/null 2>&1 || ! nvidia-smi >/dev/null 2>&1; then
  echo "ERROR: no visible NVIDIA GPU in this job (are you on a gh200 node?)."; exit 1
fi
nvidia-smi --query-gpu=name,memory.total --format=csv,noheader
python - <<'PY' || { echo "ERROR: JAX is not on the GPU in this env."; exit 1; }
import jax, sys
be = jax.default_backend()
print(f"jax {jax.__version__}  backend={be}  devices={jax.devices()}")
sys.exit(0 if be in ("gpu", "cuda", "rocm") else 1)
PY

# --- run the benchmark --------------------------------------------------------
BATCHES="${BATCHES:-4}"
NZ="${NZ:-150}"
COUNT_MAX="${COUNT_MAX:-2500}"
CHUNK="${CHUNK:-250}"
WORKERS="${WORKERS:-0}"
DEVICE_BATCH="${DEVICE_BATCH:-128}"
PROBE="${PROBE:-1}"
PROBE_BATCH="${PROBE_BATCH:-auto}"
echo "========== phase 1: tiled sweep (batches=${BATCHES}, device_batch=${DEVICE_BATCH}, nz=${NZ}, count_max=${COUNT_MAX}, chunk=${CHUNK}, workers=${WORKERS}) =========="
# shellcheck disable=SC2086
python "${SCRIPT_DIR}/gpu_benchmark.py" --batches ${BATCHES} --device-batch "${DEVICE_BATCH}" --nz "${NZ}" --count-max "${COUNT_MAX}" --chunk "${CHUNK}" --workers "${WORKERS}"
rc=$?
echo "[phase 1] sweep rc=${rc} at $(date)"

# --- phase 2: untiled Fix-B probe (fresh process -> clean allocator peak) -----
probe_rc=0
if [ "${PROBE}" = "1" ]; then
  GPU_MEM_MIB="$(nvidia-smi --query-gpu=memory.total --format=csv,noheader,nounits | head -1 | tr -d ' ')"
  if [ "${PROBE_BATCH}" = "auto" ]; then
    # A healthy chunked-Jacobian run costs ~0.17 GiB/lane (measured), so untiled
    # 512 needs ~87 GiB and 256 ~45 GiB. On the 96 GB GH200 (~86 GiB usable at
    # MEM_FRACTION=0.90) batch 512 is the *ceiling* probe -- the exact untiled
    # width that OOM'd before Fix B -- so even a healthy chunked run sits right
    # at the edge; an OOM there is reported below as a non-fatal FINDING, not a
    # job failure. Drop the 512 tier to 256 if you want every probe to fit with
    # headroom. (The pre-fix scatter transient was the ~42-61 GiB figure Fix B
    # removed -- not the healthy cost.)
    if   [ "${GPU_MEM_MIB}" -ge 92160 ]; then PROBE_BATCH=512
    elif [ "${GPU_MEM_MIB}" -ge 65536 ]; then PROBE_BATCH=256
    elif [ "${GPU_MEM_MIB}" -ge 32768 ]; then PROBE_BATCH=128
    else PROBE_BATCH=64; fi
  fi
  echo "========== phase 2: Fix-B probe — UNTILED batch ${PROBE_BATCH} on a ${GPU_MEM_MIB} MiB GPU =========="
  python "${SCRIPT_DIR}/gpu_benchmark.py" --batches "${PROBE_BATCH}" --device-batch "${PROBE_BATCH}" --nz "${NZ}" --count-max "${COUNT_MAX}" --chunk "${CHUNK}" --workers "${WORKERS}"
  probe_rc=$?
  if [ "${probe_rc}" -ne 0 ]; then
    echo "[probe] FINDING: untiled batch ${PROBE_BATCH} FAILED (rc=${probe_rc}, likely OOM)."
    echo "[probe] Diagnose with the sweep's peak-GiB column: a HEALTHY run grows"
    echo "[probe] ~0.17 GiB/lane (linear). On-trend but over the card = per-lane"
    echo "[probe] state, NOT a Fix-B failure — rerun with a smaller PROBE_BATCH."
    echo "[probe] A peak far ABOVE the trend means XLA un-did the lax.scan"
    echo "[probe] chunking in chem.chem_jac_analytical_per_layer (see"
    echo "[probe] VULCAN-JAX/docs/notes.md). Tiled production runs are unaffected."
  else
    echo "[probe] untiled batch ${PROBE_BATCH} completed — compare its peak GiB to"
    echo "[probe] the ~0.17 GiB/lane linear trend; on-trend = Fix B holds here."
  fi
fi

echo "sweep rc=${rc}, probe rc=${probe_rc} at $(date)"
exit "${rc}"
