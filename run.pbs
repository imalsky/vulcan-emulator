y = jnp.ones((size, size), dtype=jnp.float32)
t0 = time.time()
out = smoke_mm(x, y)
jax.block_until_ready(out)
t1 = time.time()
out = smoke_mm(x, y)
jax.block_until_ready(out)
t2 = time.time()
print(f"jax_smoke_first_call_s={t1 - t0:.3f}")
print(f"jax_smoke_second_call_s={t2 - t1:.3f}")
print(f"jax_smoke_output_checksum={float(jnp.sum(out)):.6e}")
