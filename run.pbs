from __future__ import annotations

import faulthandler
import os
import signal
import sys
import threading
import time
import traceback


def _register_signal_dump(signame: str) -> None:
    sig = getattr(signal, signame, None)
    if sig is None:
        return
    try:
        faulthandler.register(sig, file=sys.stderr, all_threads=True, chain=False)
        print(f"training_wrapper_registered_signal={signame}")
    except Exception as exc:  # pragma: no cover - debug path
        print(f"training_wrapper_signal_register_failed {signame}: {exc!r}", file=sys.stderr)


def _heartbeat(period_s: int) -> None:
    t0 = time.monotonic()
    heartbeat_log = os.environ.get("TRAINING_HEARTBEAT_LOG", "")
    while True:
        message = (
            f"training_wrapper_heartbeat elapsed_s={time.monotonic() - t0:.1f} "
            f"threads={threading.active_count()} pid={os.getpid()}\n"
        )
        if heartbeat_log:
            try:
                with open(heartbeat_log, "a", encoding="utf-8") as handle:
                    handle.write(message)
            except Exception:
                sys.stderr.write(message)
                sys.stderr.flush()
        else:
            sys.stderr.write(message)
            sys.stderr.flush()
        time.sleep(period_s)


def main() -> int:
    config_path = sys.argv[1]
    faulthandler.enable(file=sys.stderr, all_threads=True)
    _register_signal_dump("SIGUSR1")
    _register_signal_dump("SIGUSR2")
    heartbeat_period_s = int(os.environ.get("TRAINING_HEARTBEAT_SEC", "60"))
    threading.Thread(target=_heartbeat, args=(heartbeat_period_s,), daemon=True).start()
    wrapper_pid_file = os.environ.get("TRAINING_WRAPPER_PID_FILE", "")
    if wrapper_pid_file:
        with open(wrapper_pid_file, "w", encoding="utf-8") as handle:
            handle.write(f"{os.getpid()}\n")
    print(f"training_wrapper_pid={os.getpid()}")
    print(f"training_wrapper_ppid={os.getppid()}")
    print(f"training_wrapper_config={config_path}")
    print(f"training_wrapper_jax_log_compiles={os.environ.get('JAX_LOG_COMPILES', '<unset>')}")
    sys.stdout.flush()

    from src.utils.cli import main as cli_main

    print("training_wrapper_imported_cli")
    sys.stdout.flush()
    return int(cli_main(["--config", config_path, "--stage", "training"]))


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except Exception as exc:  # pragma: no cover - debug path
        print(f"training_wrapper_exception={exc!r}", file=sys.stderr)
        traceback.print_exc()
        raise
PY
TRAIN_PID=$!
echo "Training PID: ${TRAIN_PID}" | tee -a "${TRAIN_LOG}"
WRAPPER_PID=""
WRAPPER_PID_DEADLINE=$((SECONDS + 30))
while [ "${SECONDS}" -lt "${WRAPPER_PID_DEADLINE}" ]; do
  if [ -f "${TRAINING_WRAPPER_PID_FILE}" ]; then
    WRAPPER_PID="$(tr -d '[:space:]' < "${TRAINING_WRAPPER_PID_FILE}")"
    if [ -n "${WRAPPER_PID}" ]; then
      break
    fi
  fi
  if ! kill -0 "${TRAIN_PID}" >/dev/null 2>&1; then
    break
  fi
  sleep 1
done
if [ -z "${WRAPPER_PID}" ]; then
  echo "ERROR: training wrapper PID file was not written: ${TRAINING_WRAPPER_PID_FILE}" | tee -a "${TRAIN_LOG}"
  set +e
  wait "${TRAIN_PID}"
  TRAIN_RC=$?
  set -e
  echo "Training stage exit code: ${TRAIN_RC}" | tee -a "${TRAIN_LOG}"
  exit 1
fi
echo "Training wrapper PID: ${WRAPPER_PID}" | tee -a "${TRAIN_LOG}"
if [ "${TRAIN_PID}" != "${WRAPPER_PID}" ]; then
  echo "ERROR: Training PID mismatch: launcher pid=${TRAIN_PID} wrapper pid=${WRAPPER_PID}" | tee -a "${TRAIN_LOG}"
  kill "${TRAIN_PID}" >/dev/null 2>&1 || true
  kill "${WRAPPER_PID}" >/dev/null 2>&1 || true
  set +e
  wait "${TRAIN_PID}"
  set -e
  exit 1
fi
start_process_monitor
start_stack_watchdog
set +e
wait "${TRAIN_PID}"
TRAIN_RC=$?
set -e
echo "Training stage exit code: ${TRAIN_RC}" | tee -a "${TRAIN_LOG}"
echo "Training stage elapsed seconds: $((SECONDS - TRAIN_STAGE_T0))" | tee -a "${TRAIN_LOG}"
if [ "${TRAIN_RC}" -ne 0 ]; then
  exit "${TRAIN_RC}"
fi

echo "Done. Artifacts written under the configured models/ directory."
