#!/bin/bash
#PBS -N vulcan_emulator
#PBS -q gpu_long
#PBS -W group_list=s2458
#PBS -l select=1:ncpus=70:ngpus=1:mem=400gb:model=gh200
#PBS -l walltime=72:00:00
#PBS -j oe
#PBS -m abe

# Required in the HPC conda env used for this job:
#   torch, numpy, scipy, h5py, tqdm
# Required only if fastchem_vulcan/fastchem is missing and you want this script to build it:
#   make, g++
# Required for the current bundled VULCAN runtime:
#   matplotlib
# Optional VULCAN extras only if you rebuild chem_funs.py or use image utilities:
#   sympy, Pillow
# Current config/config.json sets training.device="cuda", and live sampling expects a GPU.

set -euo pipefail

PROJECT_ROOT="${PROJECT_ROOT:-${PBS_O_WORKDIR:?}}"
cd "${PROJECT_ROOT}"
export VULCAN_EMULATOR_PROJECT_ROOT="${PROJECT_ROOT}"

module purge
module use -a /swbuild/analytix/tools/modulefiles
module load miniconda3/gh2

if ! command -v conda >/dev/null 2>&1; then
  echo "ERROR: conda not found after module load."
  exit 1
fi

CONDA_BASE="$(conda info --base)"
# shellcheck disable=SC1090
source "${CONDA_BASE}/etc/profile.d/conda.sh"

CONDA_ENV="${CONDA_ENV:-pyt2_8_gh}"
set +e
conda activate "${CONDA_ENV}"
rc=$?
set -e
if [ "${rc}" -ne 0 ]; then
  echo "ERROR: failed to activate conda env: ${CONDA_ENV}"
  conda info --envs || true
  exit 2
fi

export VULCAN_EMULATOR_CONDA_ENV="${CONDA_ENV}"

CONFIG_PATH="${CONFIG_PATH:-config/config.json}"
TRAIN_LOG="${TRAIN_LOG:-}"
BUILD_FASTCHEM_IF_MISSING="${BUILD_FASTCHEM_IF_MISSING:-1}"
RUN_MODE="${RUN_MODE:-pipeline}"
HYPERPARAM_TRIALS="${HYPERPARAM_TRIALS:-12}"
HYPERPARAM_TRIAL_EPOCHS="${HYPERPARAM_TRIAL_EPOCHS:-20}"
HYPERPARAM_OVERWRITE="${HYPERPARAM_OVERWRITE:-0}"
export RUN_MODE
DID_STANDARD_TRAIN=0
DID_HYPERPARAM=0

export HDF5_USE_FILE_LOCKING=FALSE
export KMP_DUPLICATE_LIB_OK=TRUE
export MPLBACKEND="${MPLBACKEND:-Agg}"
export MPLCONFIGDIR="${MPLCONFIGDIR:-${PROJECT_ROOT}/.mplconfig}"
export PYTHONUNBUFFERED=1
export PYTHONPATH="${PROJECT_ROOT}/src:${PROJECT_ROOT}:${PYTHONPATH:-}"
export PIP_DISABLE_PIP_VERSION_CHECK=1

mkdir -p "${MPLCONFIGDIR}"

if [ "${CONFIG_PATH#/}" != "${CONFIG_PATH}" ]; then
  echo "ERROR: CONFIG_PATH must be relative because src/main.py rejects absolute config paths."
  exit 1
fi
if [ ! -f "${CONFIG_PATH}" ]; then
  echo "ERROR: config not found: ${CONFIG_PATH}"
  exit 1
fi
if [ ! -f "${PROJECT_ROOT}/src/main.py" ]; then
  echo "ERROR: src/main.py not found under ${PROJECT_ROOT}"
  exit 1
fi
if [ ! -f "${PROJECT_ROOT}/src/hyperparam_testing.py" ]; then
  echo "ERROR: src/hyperparam_testing.py not found under ${PROJECT_ROOT}"
  exit 1
fi
if [ "${RUN_MODE}" != "pipeline" ] && [ "${RUN_MODE}" != "train" ] && [ "${RUN_MODE}" != "hyperparam" ]; then
  echo "ERROR: RUN_MODE must be 'pipeline', 'train', or 'hyperparam', got: ${RUN_MODE}"
  exit 1
fi

mapfile -t CONFIG_INFO < <(python - "${CONFIG_PATH}" <<'PY'
import json
import os
import sys
from pathlib import Path

project_root = Path(os.path.normpath(os.environ["VULCAN_EMULATOR_PROJECT_ROOT"]))
config_path = Path(os.path.normpath(str(project_root / sys.argv[1])))
with config_path.open("r", encoding="utf-8") as handle:
    config = json.load(handle)

print(config_path)
print(Path(os.path.normpath(str(project_root / config["paths"]["vulcan_source_path"]))))
print(Path(os.path.normpath(str(project_root / config["paths"]["logs_root"]))))
print(
    Path(
        os.path.normpath(
            str(project_root / config["paths"]["models_root"] / config["training"]["output_folder"])
        )
    )
)
print(str(config["training"]["device"]).lower())
print(Path(os.path.normpath(str(project_root / config["paths"]["models_root"] / "hyperparam_testing"))))
PY
)

CONFIG_ABS="${CONFIG_INFO[0]}"
VULCAN_SOURCE="${CONFIG_INFO[1]}"
LOGS_ROOT="${CONFIG_INFO[2]}"
RUN_DIR="${CONFIG_INFO[3]}"
TRAIN_DEVICE="${CONFIG_INFO[4]}"
HYPERPARAM_ROOT="${CONFIG_INFO[5]}"
export TRAIN_DEVICE

if [ -n "${VULCAN_SOURCE_OVERRIDE:-}" ]; then
  VULCAN_SOURCE="${VULCAN_SOURCE_OVERRIDE}"
  export VULCAN_EMULATOR_VULCAN_SOURCE="${VULCAN_SOURCE}"
else
  VULCAN_SOURCE="${CONFIG_INFO[1]}"
  unset VULCAN_EMULATOR_VULCAN_SOURCE || true
fi

if [ -z "${TRAIN_LOG}" ]; then
  TRAIN_LOG="${LOGS_ROOT}/${RUN_MODE}_${PBS_JOBID:-manual}.log"
fi

mkdir -p "${LOGS_ROOT}" "$(dirname "${TRAIN_LOG}")"

echo "PBS_JOBID: ${PBS_JOBID:-manual}"
echo "Host: $(hostname)"
echo "Project root: ${PROJECT_ROOT}"
echo "Config: ${CONFIG_ABS}"
echo "VULCAN source: ${VULCAN_SOURCE}"
if [ "${VULCAN_SOURCE}" != "${CONFIG_INFO[1]}" ]; then
  echo "VULCAN source override active (config requested ${CONFIG_INFO[1]})"
fi
echo "Run mode: ${RUN_MODE}"
echo "Training device from config: ${TRAIN_DEVICE}"

if [ "${RUN_MODE}" != "hyperparam" ]; then
  for required_path in \
    "${VULCAN_SOURCE}" \
    "${VULCAN_SOURCE}/vulcan.py" \
    "${VULCAN_SOURCE}/vulcan_cfg.py" \
    "${VULCAN_SOURCE}/chem_funs.py" \
    "${VULCAN_SOURCE}/fastchem_vulcan"; do
    if [ ! -e "${required_path}" ]; then
      echo "ERROR: missing VULCAN runtime path: ${required_path}"
      exit 1
    fi
  done
  if [ ! -x "${VULCAN_SOURCE}/fastchem_vulcan/fastchem" ] && [ "${BUILD_FASTCHEM_IF_MISSING}" = "1" ]; then
    if ! command -v make >/dev/null 2>&1; then
      echo "ERROR: FastChem binary is missing and 'make' is unavailable to build it."
      exit 1
    fi
    echo "Stage: building FastChem in ${VULCAN_SOURCE}/fastchem_vulcan"
    make -C "${VULCAN_SOURCE}/fastchem_vulcan"
  fi
  if [ ! -x "${VULCAN_SOURCE}/fastchem_vulcan/fastchem" ]; then
    echo "ERROR: missing executable FastChem binary: ${VULCAN_SOURCE}/fastchem_vulcan/fastchem"
    exit 1
  fi
fi
if [ "${RUN_MODE}" = "hyperparam" ]; then
  echo "Hyperparameter mode skips VULCAN/FastChem preflight."
fi

if [ -n "${PBS_NODEFILE:-}" ] && [ -f "${PBS_NODEFILE}" ]; then
  echo "Allocated nodes:"
  sort -u "${PBS_NODEFILE}" || true
fi

if [ "${TRAIN_DEVICE}" = "cuda" ]; then
  if ! command -v nvidia-smi >/dev/null 2>&1 || ! nvidia-smi >/dev/null 2>&1; then
    echo "ERROR: training.device='cuda' but no visible NVIDIA GPU is available."
    exit 1
  fi
fi

if ! python - "${CONFIG_PATH}" <<'PY'
import importlib
import json
import os
import sys
from pathlib import Path

config_path = Path(sys.argv[1])
with config_path.open("r", encoding="utf-8") as handle:
    config = json.load(handle)

required = ["torch", "numpy", "scipy", "h5py", "tqdm"]
if os.environ.get("RUN_MODE") != "hyperparam":
    required.append("matplotlib")

missing: list[str] = []
for name in required:
    try:
        module = importlib.import_module(name)
        version = getattr(module, "__version__", "unknown")
        print(f"{name}=={version}")
    except Exception as exc:  # pragma: no cover - batch preflight only
        missing.append(f"{name}: {exc}")

if missing:
    print("Missing required Python packages for vulcan-emulator:", file=sys.stderr)
    for item in missing:
        print(f"  - {item}", file=sys.stderr)
    raise SystemExit(1)

import torch

if os.environ.get("TRAIN_DEVICE") == "cuda" and not torch.cuda.is_available():
    print(
        "training.device='cuda' requested but torch.cuda.is_available() is False.",
        file=sys.stderr,
    )
    raise SystemExit(1)
PY
then
  echo "ERROR: Python runtime preflight failed."
  exit 1
fi

ensure_optuna() {
  if ! python - <<'PY'
import optuna
print(optuna.__version__)
PY
  then
    echo "Stage: installing optuna"
    python -m pip install --user optuna
    python - <<'PY'
import optuna
print(optuna.__version__)
PY
  fi
}

run_hyperparam_search() {
  echo "Hyperparameter search settings:"
  echo "  trials: ${HYPERPARAM_TRIALS}"
  echo "  trial epochs: ${HYPERPARAM_TRIAL_EPOCHS}"
  echo "  overwrite: ${HYPERPARAM_OVERWRITE}"
  echo "  output root: ${HYPERPARAM_ROOT}"

  HYPERPARAM_ARGS=(
    --config "${CONFIG_PATH}"
    --trials "${HYPERPARAM_TRIALS}"
    --trial-epochs "${HYPERPARAM_TRIAL_EPOCHS}"
  )
  if [ "${HYPERPARAM_OVERWRITE}" = "1" ]; then
    HYPERPARAM_ARGS+=(--overwrite)
  fi
  ensure_optuna
  DID_HYPERPARAM=1
  python -u src/hyperparam_testing.py "${HYPERPARAM_ARGS[@]}" 2>&1 | tee -a "${TRAIN_LOG}"
}

if [ "${RUN_MODE}" = "pipeline" ]; then
  echo "Execution control:"
  echo "  Default: regenerate data, then run standard training."
  echo "  Hyperparameter search wiring is left in place below but disabled by default."
  echo "Training log file: ${TRAIN_LOG}"
  : > "${TRAIN_LOG}"

  # Comment out this line if you want to skip generation.
  python -u src/main.py --gen --config "${CONFIG_PATH}" 2>&1 | tee -a "${TRAIN_LOG}"

  # Uncomment this line to run hyperparameter search instead of standard training.
  # run_hyperparam_search

  # Standard full run on the regenerated data.
  DID_STANDARD_TRAIN=1
  python -u src/main.py --train --config "${CONFIG_PATH}" 2>&1 | tee -a "${TRAIN_LOG}"
elif [ "${RUN_MODE}" = "train" ]; then
  echo "Execution control:"
  echo "  Standard training-only mode."
  echo "Training log file: ${TRAIN_LOG}"
  : > "${TRAIN_LOG}"
  DID_STANDARD_TRAIN=1
  python -u src/main.py --train --config "${CONFIG_PATH}" 2>&1 | tee -a "${TRAIN_LOG}"
else
  echo "Execution control:"
  echo "  Hyperparameter-search-only mode."
  echo "Training log file: ${TRAIN_LOG}"
  : > "${TRAIN_LOG}"
  run_hyperparam_search
fi

echo "Completed successfully."
if [ "${DID_STANDARD_TRAIN}" = "1" ] && [ -f "${RUN_DIR}/best.pt" ]; then
  echo "Best checkpoint: ${RUN_DIR}/best.pt"
fi
if [ "${DID_HYPERPARAM}" = "1" ] && [ -f "${HYPERPARAM_ROOT}/best_model/best.pt" ]; then
  echo "Best checkpoint: ${HYPERPARAM_ROOT}/best_model/best.pt"
fi
