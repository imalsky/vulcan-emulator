import os
import time

import jax
import jax.numpy as jnp

size = int(os.environ.get("JAX_SMOKE_SIZE", "2048"))
device = jax.devices()[0]
print(f"jax_smoke_device={device}")
print(f"jax_smoke_size={size}")

@jax.jit
def smoke_mm(x, y):
    return x @ y

