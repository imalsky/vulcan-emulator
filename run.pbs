#!/bin/bash
#PBS -N vulcan_emulator
#PBS -q gpu_long
#PBS -W group_list=s2458
#PBS -l select=1:ncpus=32:ngpus=1:mem=400gb:model=gh200
#PBS -l walltime=72:00:00
#PBS -j oe
#PBS -m abe

set -euo pipefail

PROJECT_ROOT="${PROJECT_ROOT:-${PBS_O_WORKDIR:?}}"
cd -P "${PROJECT_ROOT}"

module purge
module use -a /swbuild/analytix/tools/modulefiles
module load miniconda3/gh2

if ! command -v conda >/dev/null 2>&1; then
  echo "ERROR: conda not found after module load."
  exit 1
fi

CONDA_BASE="$(conda info --base)"
# shellcheck disable=SC1090
source "${CONDA_BASE}/etc/profile.d/conda.sh"

CONDA_ENV="${CONDA_ENV:-pyt2_8_gh}"
set +e
conda activate "${CONDA_ENV}"
rc=$?
set -e
if [ "${rc}" -ne 0 ]; then
  echo "ERROR: failed to activate conda env: ${CONDA_ENV}"
  conda info --envs || true
  exit 2
fi

CONFIG_PATH="${CONFIG_PATH:-config/equilibrium_only_config.json}"
RUN_GEN_IF_MISSING="${RUN_GEN_IF_MISSING:-1}"
REQUIRE_JAX_GPU="${REQUIRE_JAX_GPU:-1}"
DISABLE_TRITON_GEMM="${DISABLE_TRITON_GEMM:-1}"

export HDF5_USE_FILE_LOCKING=FALSE
export PYTHONPATH="${PROJECT_ROOT}/src:${PROJECT_ROOT}:${PYTHONPATH:-}"
export JAX_ENABLE_X64="${JAX_ENABLE_X64:-1}"
export XLA_PYTHON_CLIENT_PREALLOCATE="${XLA_PYTHON_CLIENT_PREALLOCATE:-true}"
export XLA_PYTHON_CLIENT_MEM_FRACTION="${XLA_PYTHON_CLIENT_MEM_FRACTION:-0.90}"
export REQUIRE_JAX_GPU
export PIP_DISABLE_PIP_VERSION_CHECK=1

if [ "${DISABLE_TRITON_GEMM}" = "1" ]; then
  export XLA_FLAGS="${XLA_FLAGS:-} --xla_gpu_enable_triton_gemm=false"
fi
export XLA_FLAGS="${XLA_FLAGS:-} --xla_gpu_autotune_level=0"

if [ -n "${PBS_JOBID:-}" ]; then
  echo "PBS_JOBID: ${PBS_JOBID}"
  if ! command -v nvidia-smi >/dev/null 2>&1 || ! nvidia-smi >/dev/null 2>&1; then
    echo "ERROR: No visible NVIDIA GPU in this PBS job."
    exit 1
  fi
fi

if [ ! -f "${CONFIG_PATH}" ]; then
  echo "ERROR: config not found: ${CONFIG_PATH}"
  exit 1
fi
if [ ! -d "${PROJECT_ROOT}/src" ]; then
  echo "ERROR: source directory not found: ${PROJECT_ROOT}/src"
  exit 1
fi
if [ ! -f "${PROJECT_ROOT}/src/models/jax_model.py" ]; then
  echo "ERROR: required source file not found: ${PROJECT_ROOT}/src/models/jax_model.py"
  exit 1
fi

echo "Config path: $(python - <<'PY' "${CONFIG_PATH}"
from pathlib import Path
import sys
print(Path(sys.argv[1]).resolve())
PY
)"
echo "Launcher defaults: JAX_ENABLE_X64=${JAX_ENABLE_X64} XLA_PYTHON_CLIENT_PREALLOCATE=${XLA_PYTHON_CLIENT_PREALLOCATE} DISABLE_TRITON_GEMM=${DISABLE_TRITON_GEMM}"

# Fail early if the environment cannot provide the requested JAX accelerator.
if ! python - <<'PY'
import os
import sys

ok = True
jax_backend = "unknown"
try:
    import jax

    jax_backend = str(jax.default_backend()).lower()
except Exception as exc:
    print(f"jax_error={exc!r}")
    ok = False
if os.environ.get("REQUIRE_JAX_GPU", "0") == "1" and jax_backend not in {"gpu", "cuda", "rocm", "metal"}:
    print(f"ERROR: REQUIRE_JAX_GPU=1 but jax backend is '{jax_backend}'", file=sys.stderr)
    ok = False
raise SystemExit(0 if ok else 1)
PY
then
  echo "ERROR: runtime preflight failed."
  exit 1
fi

echo "Stage: dataset generation check (RUN_GEN_IF_MISSING=${RUN_GEN_IF_MISSING})"
if [ "${RUN_GEN_IF_MISSING}" = "1" ]; then
  DATA_CFG_RAW="$(python - "${CONFIG_PATH}" <<'PY'
from pathlib import Path
import json
import sys
import h5py

config_path = Path(sys.argv[1]).resolve()
project_root = Path.cwd()
with config_path.open("r", encoding="utf-8") as handle:
    cfg = json.load(handle)
raw_root = Path(str(cfg["paths"]["raw_root"]))
if not raw_root.is_absolute():
    raw_root = (project_root / raw_root).resolve()
print(raw_root / "runs")
print(int(cfg["generation"]["num_runs"]))
consolidated_path = raw_root / "runs.h5"
print(consolidated_path)
if consolidated_path.exists():
    with h5py.File(consolidated_path, "r") as handle:
        print(len(handle.keys()))
else:
    print(0)
PY
  )" || {
    echo "ERROR: failed to inspect config: ${CONFIG_PATH}"
    exit 1
  }
  mapfile -t DATA_CFG <<<"${DATA_CFG_RAW}"
  if [ "${#DATA_CFG[@]}" -lt 4 ]; then
    echo "ERROR: config inspection did not return raw_root, num_runs, and consolidated metadata."
    exit 1
  fi
  RAW_RUN_DIR="${DATA_CFG[0]}"
  EXPECTED_RUNS="${DATA_CFG[1]}"
  CONSOLIDATED_PATH="${DATA_CFG[2]}"
  CONSOLIDATED_COUNT="${DATA_CFG[3]}"
  RUN_COUNT=0
  if [ -d "${RAW_RUN_DIR}" ]; then
    RUN_COUNT="$(find "${RAW_RUN_DIR}" -maxdepth 1 -type f -name 'run_*.h5' | wc -l | tr -d ' ')"
  fi
  if [ "${CONSOLIDATED_COUNT}" -eq "${EXPECTED_RUNS}" ]; then
    echo "Stage: raw dataset already present in consolidated file (${CONSOLIDATED_COUNT} runs), skipping generation"
  elif [ "${RUN_COUNT}" -eq "${EXPECTED_RUNS}" ]; then
    echo "Stage: raw dataset already present (${RUN_COUNT} runs), skipping generation"
  elif [ "${RUN_COUNT}" -eq 0 ] && [ "${CONSOLIDATED_COUNT}" -eq 0 ]; then
    echo "Stage: generating raw runs"
    python -u -m src.utils --config "${CONFIG_PATH}" --stage generation
  else
    echo "ERROR: raw-run count mismatch: found ${RUN_COUNT} per-file runs in ${RAW_RUN_DIR} and ${CONSOLIDATED_COUNT} runs in ${CONSOLIDATED_PATH}, expected ${EXPECTED_RUNS}."
    echo "Set generation.overwrite=true and regenerate, or align generation.num_runs with the existing dataset."
    exit 1
  fi
fi

echo "Stage: preprocessing"
python -u -m src.utils --config "${CONFIG_PATH}" --stage normalization

echo "Stage: training"
python -u -m src.utils --config "${CONFIG_PATH}" --stage training
